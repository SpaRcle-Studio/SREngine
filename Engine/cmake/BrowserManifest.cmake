set(SR_BROWSER_JSON "{\n  \"files\": {")
set(SR_BROWSER_SEPARATOR "")
foreach(SR_BROWSER_SUFFIX IN ITEMS js wasm data)
    set(SR_BROWSER_FILE "${SR_BROWSER_NAME}.${SR_BROWSER_SUFFIX}")
    file(SHA256 "${SR_BROWSER_BIN}/${SR_BROWSER_FILE}" SR_BROWSER_HASH)
    string(APPEND SR_BROWSER_JSON "${SR_BROWSER_SEPARATOR}\n    \"${SR_BROWSER_FILE}\": \"${SR_BROWSER_HASH}\"")
    set(SR_BROWSER_SEPARATOR ",")
endforeach()
string(APPEND SR_BROWSER_JSON "\n  }\n}\n")
file(WRITE "${SR_BROWSER_BIN}/SREngine.manifest.json" "${SR_BROWSER_JSON}")
