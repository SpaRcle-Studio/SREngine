if (ANDROID_NDK)
    set(SR_ENGINE_USE_MODULAR_BUILD OFF)
else()
    option(SR_ENGINE_USE_MODULAR_BUILD "Separate the engine into modular libraries" ON)
endif()

if (SR_ENGINE_USE_MODULAR_BUILD)
    set(SR_COMMON_STATIC_LIBRARY OFF)
    set(SR_SCRIPTING_STATIC_LIBRARY OFF)
    set(SR_AUDIO_STATIC_LIBRARY OFF)
    set(SR_PHYSICS_STATIC_LIBRARY OFF)
    set(SR_GRAPHICS_STATIC_LIBRARY OFF)
else()
    set(SR_COMMON_STATIC_LIBRARY ON)
    set(SR_SCRIPTING_STATIC_LIBRARY ON)
    set(SR_AUDIO_STATIC_LIBRARY ON)
    set(SR_PHYSICS_STATIC_LIBRARY ON)
    set(SR_GRAPHICS_STATIC_LIBRARY ON)
endif()

if (SR_COMMON_STATIC_LIBRARY)
    set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -DSR_COMMON_STATIC_LIBRARY")
endif()

if (SR_SCRIPTING_STATIC_LIBRARY)
    set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -DSR_SCRIPTING_STATIC_LIBRARY")
endif()

if (SR_AUDIO_STATIC_LIBRARY)
    set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -DSR_AUDIO_STATIC_LIBRARY")
endif()

if (SR_PHYSICS_STATIC_LIBRARY)
    set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -DSR_PHYSICS_STATIC_LIBRARY")
endif()

if (SR_GRAPHICS_STATIC_LIBRARY)
    set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -DSR_GRAPHICS_STATIC_LIBRARY")
endif()