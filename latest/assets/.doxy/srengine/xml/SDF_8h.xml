      <memberdef kind="define" id="SDF_8h_1a0d6c770b3aea2cf38612f5d23645757b" prot="public" static="no">
        <name>SR_SRF_COMPARE</name>
        <param><defname>offsetx</defname></param>
        <param><defname>offsety</defname></param>
        <initializer>    do {                                                                           \
        int add;                                                                   \
        Point other = Get(x + offsetx, y + offsety);                               \
        if(offsety == 0) {                                                         \
            add = 2 * other.dx + 1;                                                \
        }                                                                          \
        else if(offsetx == 0) {                                                    \
            add = 2 * other.dy + 1;                                                \
        }                                                                          \
        else {                                                                     \
            add = 2 * (other.dy + other.dx + 1);                                   \
        }                                                                          \
        other.f += add;                                                            \
        if (other.f &lt; p.f)                                                         \
        {                                                                          \
            p.f = other.f;                                                         \
            if(offsety == 0) {                                                     \
                p.dx = other.dx + 1;                                               \
                p.dy = other.dy;                                                   \
            }                                                                      \
            else if(offsetx == 0) {                                                \
                p.dy = other.dy + 1;                                               \
                p.dx = other.dx;                                                   \
            }                                                                      \
            else {                                                                 \
                p.dy = other.dy + 1;                                               \
                p.dx = other.dx + 1;                                               \
            }                                                                      \
        }                                                                          \
    } while(0)</initializer>
