sra format
0-r:Root
	1-o:asset
		2-v:type
			3-s:FileRenderTechniqueResource
		2-o:ptr
			3-o:data
				4-v:name
					5-s:Geometry + No Debug
				4-o:pass
					5-v:type
						6-s:GroupPass
					5-o:ptr
						6-a:passes
							7-k:i
								8-o:d
									9-v:type
										10-s:FrameBufferPass
									9-o:ptr
										10-v:customName
											11-s:SceneView
										10-a:passes
											11-k:i
												12-o:d
													13-v:type
														14-s:ClearBuffersPass
													13-o:ptr
											11-k:i
												12-o:d
													13-v:type
														14-s:MeshDrawerPass
													13-o:ptr
														14-a:allowedLayers
															15-k:i
																16-v:d
																	17-s:Default
															15-k:i
																16-v:d
																	17-s:Opaque
											11-k:i
												12-o:d
													13-v:type
														14-s:SkyboxPass
													13-o:ptr
														14-v:skyboxPath
															15-s:Engine/Skyboxes/Sun.png
														14-v:shaderPath
															15-s:Engine/Shaders/skybox.srsl
											11-k:i
												12-o:d
													13-v:type
														14-s:MeshDrawerPass
													13-o:ptr
														14-a:disallowedLayers
															15-k:i
																16-v:d
																	17-s:Gizmo
															15-k:i
																16-v:d
																	17-s:Default
															15-k:i
																16-v:d
																	17-s:Opaque
															15-k:i
																16-v:d
																	17-s:GizmoSelection
											11-k:i
												12-o:d
													13-v:type
														14-s:PostProcessPass
													13-o:ptr
														14-v:vertices
															15-i:4
														14-v:shaderPath
															15-s:Editor/Shaders/grid.srsl
											11-k:i
												12-o:d
													13-v:type
														14-s:ClearBuffersPass
													13-o:ptr
														14-v:clearColor
															15-b:false
											11-k:i
												12-o:d
													13-v:type
														14-s:MeshDrawerPass
													13-o:ptr
														14-a:allowedLayers
															15-k:i
																16-v:d
																	17-s:Gizmo
										10-o:data
											11-a:clearColors
												12-k:i
													13-o:d
											11-v:frameBufferName
												12-s:SceneView
											11-o:depth
												12-v:has
													13-b:true
												12-v:value
													13-f:1
				4-a:frameBuffers
					5-k:i
						6-o:d
							7-v:type
								8-s:FrameBufferController
							7-o:ptr
								8-v:name
									9-s:SceneView
								8-o:preScale
									9-v:x
										10-f:1
									9-v:y
										10-f:1
								8-a:colorFormats
									9-k:i
										10-v:d
											11-s:RGBA8_UNORM
								8-o:features
									9-v:depthLoad
										10-b:true
									9-v:colorLoad
										10-b:true
									9-v:depthTransferDst
										10-b:true
									9-v:colorTransferDst
										10-b:true
				4-a:queues
					5-k:i
						6-o:d
							7-a:frameBuffers
								8-k:i
									9-v:d
										10-s:SceneView
