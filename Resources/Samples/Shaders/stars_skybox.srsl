ShaderType Skybox;

PolygonMode Fill;
CullMode Back;
DepthCompare LessOrEqual;
PrimitiveTopology TriangleList;
BlendEnabled false;
DepthWrite true;
DepthTest true;

[[uniform], [public]] vec3 sky_color = vec3(0.03, 0.05, 0.11);
[[uniform], [public]] vec3 star_base_color = vec3(1.0, 1.0, 1.0);
[[uniform], [public]] float star_hue_offset = 1.0;
[[uniform], [public]] float star_intensity = 0.08;
[[uniform], [public]] float star_twinkle_speed = 0.001;
[[uniform], [public]] float star_twinkle_intensity = 0.2;
[[uniform], [public]] float layer_scale = 60.0;
[[uniform], [public]] float layer_scale_step = 1.0;
[[uniform], [public]] int layers_count = 1;

[[const]] float PI = 3.14159265358979323846;
[[const]] float TAU = 6.28318530717958647692;

vec3 hue(vec3 input_val, float offset, int range_index) {
	// RGB to HSV
	vec4 k = vec4(0.0, -1.0/3.0, 2.0/3.0, -1.0);
	vec4 p = mix(vec4(input_val.bg, k.wz), vec4(input_val.gb, k.xy), step(input_val.b, input_val.g));
	vec4 q = mix(vec4(p.xyw, input_val.r), vec4(input_val.r, p.yzx), step(p.x, input_val.r));
	float d = q.x - min(q.w, q.y);
	//float e = 1.e-10;
	float e = 0.0000000001;
	vec3 hsv = vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);

	//offset = (range_index == 0) ? offset / 360.0 : offset;
	if (range_index == 0) {
	    offset = offset / 360.0;
	}

	float hue = hsv.x + offset;
	if (hue < 0.0) {
		hsv.x = hue + 1.0;
	} else if (hue > 1.0) {
		hsv.x = hue - 1.0;
	} else {
		hsv.x = hue;
	}

	// HSV to RGB
	vec4 k2 = vec4(1.0, 2.0/3.0, 1.0/3.0, 3.0);
	vec3 p2 = abs(fract(hsv.xxx + k2.xyz) * 6.0 - k2.www);
	vec3 rgb = hsv.z * mix(k2.xxx, clamp(p2 - k2.xxx, 0.0, 1.0), hsv.y);
	return rgb;
}

vec3 hash(vec3 x) {
	x = vec3(dot(x, vec3(127.1,311.7, 74.7)),
			 dot(x, vec3(269.5,183.3,246.1)),
			 dot(x, vec3(113.5,271.9,124.6)));
	return fract(sin(x) * 43758.5453123);
}

vec2 voronoi(vec3 x){
	vec3 p = floor(x);
	vec3 f = fract(x);

	float res = 100.0;
	float id = 0.0;

	for (float k = -1.0; k <= 1.0; k += 1.0) {
		for (float j = -1.0; j <= 1.0; j += 1.0) {
			for (float i = -1.0; i <= 1.0; i += 1.0) {
				vec3 b = vec3(i, j, k);
				vec3 r = vec3(b) - f + hash(p + b);
				float d = dot(r, r);
				if (d < res) {
					res = d;
					id = dot(p + b, vec3(0.0, 57.0, 113.0));
				}
		    }
		}
	}

	return vec2(sqrt(res), id);
}

void fragment() {
	COLOR = vec4(0.0, 0.0, 0.0, 1.0);
	COLOR.rgb = sky_color;

    for (int i = 0; i < layers_count; i++) {
        vec3 pos = normalize(VERTEX) * (layer_scale + float(i) * layer_scale_step);
        vec2 layer = voronoi(pos);

        vec3 rand = hash(vec3(layer.y));

        float twinkle = sin(TIME * PI * star_twinkle_speed + rand.x * TAU);
        twinkle *= star_twinkle_intensity;
        float star = smoothstep(star_intensity + star_intensity * twinkle, 0.0, layer.x);

        vec3 star_color = star * hue((COLOR.rgb + star_base_color), rand.y * star_hue_offset, 1);

        COLOR.rgb += star_color;
    }
}

void vertex() {
    OUT_POSITION = (PROJECTION_MATRIX * VIEW_NO_TRANSLATE_MATRIX * vec4(VERTEX, 1.0)).xyww;
}