ShaderType Compute;

struct Vertex {
    vec3 position;
    vec3 normal;
    ivec2 id;
};

struct Triangle {
    Vertex c;
    Vertex b;
    Vertex a;
};

[[ssbo(triangles)]] uint count;
[[ssbo(triangles)]] Triangle[] triangles;

[[ssbo(densities)]] float[] densities;

#include <Samples/MarchingCubes/MarchTables.srsl>

[[const]] int densityCountAxis = 64;
[[const]] float isoLevel = 0.2;
[[const]] float voxelSize = 0.1;
[[const]] int numPointsPerAxis = 16;

float GetDensity(ivec3 pos) {
    if (pos.x < 0 || pos.x >= densityCountAxis ||
        pos.y < 0 || pos.y >= densityCountAxis ||
        pos.z < 0 || pos.z >= densityCountAxis) {
        return 0.0;
    }
    int index = pos.z * densityCountAxis * densityCountAxis + pos.y * densityCountAxis + pos.x;
    return densities[index];
}

vec3 coordToWorld(ivec3 coord) {
    float planetSize = 1.0;
    int textureSize = 2;
    return (coord / (textureSize - 1.0) - 0.5) * planetSize;
}

vec3 calculateNormal(ivec3 coord) {
    ivec3 offsetX = ivec3(1, 0, 0);
    ivec3 offsetY = ivec3(0, 1, 0);
    ivec3 offsetZ = ivec3(0, 0, 1);

    float dx = GetDensity(coord + offsetX) - GetDensity(coord - offsetX);
    float dy = GetDensity(coord + offsetY) - GetDensity(coord - offsetY);
    float dz = GetDensity(coord + offsetZ) - GetDensity(coord - offsetZ);

    return normalize(vec3(dx, dy, dz));
}

[[THREADS(8, 8, 8)]]
void compute() {
    ivec3 voxelPos = ivec3(GLOBAL_INVOCATION_ID.xyz);

    // Шаг 1: вычисляем координаты углов
    ivec3 cornerCoords[8];
    for (int i = 0; i < 8; ++i) {
        cornerCoords[i] = voxelPos + cornerOffsets[i];
    }

    // Шаг 2: вычисляем плотности, нормали и мировые координаты
    float densitiesCorner[8];
    vec3 normalsCorner[8];
    vec3 worldPositions[8];
    for (int i = 0; i < 8; ++i) {
        densitiesCorner[i] = GetDensity(cornerCoords[i]);
        normalsCorner[i] = calculateNormal(cornerCoords[i]);
        worldPositions[i] = coordToWorld(cornerCoords[i]);
    }

    // Шаг 3: определяем cubeIndex
    int cubeIndex = 0;
    for (int i = 0; i < 8; ++i) {
        if (densitiesCorner[i] < isoLevel) {
            cubeIndex |= (1 << i);
        }
    }

    int edgeFlags = edgeTable[cubeIndex];
    if (edgeFlags == 0) {
        return;
    }

    // Шаг 4: вычисляем вершины на рёбрах
    Vertex edgeVertices[12];

    for (int e = 0; e < 12; ++e) {
        if ((edgeFlags & (1 << e)) != 0) {
            int a = cornerIndexAFromEdge[e];
            int b = cornerIndexBFromEdge[e];

            float dA = densitiesCorner[a];
            float dB = densitiesCorner[b];

            float t = (isoLevel - dA) / (dB - dA);
            t = clamp(t, 0.0, 1.0);

            vec3 pA = worldPositions[a];
            vec3 pB = worldPositions[b];
            vec3 nA = normalsCorner[a];
            vec3 nB = normalsCorner[b];

            vec3 pos = mix(pA, pB, t);
            vec3 norm = normalize(nA + t * (nB - nA));

            edgeVertices[e].position = pos;
            edgeVertices[e].normal = norm;
        }
    }

    // Шаг 5: создаём треугольники
    int[] edges = triangulation_official[cubeIndex];
    for (int i = 0; i < 15; i += 3) {
        int ea = edges[i];
        if (ea == -1) { break; }

        int eb = edges[i + 1];
        int ec = edges[i + 2];

        uint index = atomicAdd(count, 1);

        triangles[index].a = edgeVertices[ec];
        triangles[index].b = edgeVertices[eb];
        triangles[index].c = edgeVertices[ea];
    }
}

