[[const]] uint EMPTY_KEY = 0xFFFFFFFFu;
[[const]] uint RESERVED_MARKER = 0xFFFFFFFEu;

int hash3D(ivec3 coord) {
    return coord.x + coord.y * densityCountAxis + coord.z * densityCountAxis * densityCountAxis;
}

int computeEdgeCode(ivec3 a, ivec3 b) {
    ivec3 d = abs(a - b);
    if (d.x == 1) { return 0; }
    if (d.y == 1) { return 1; }
    if (d.z == 1) { return 2; }
    return 3; // ошибка или диагональ (не должно быть)
}

uint hashVertexID(ivec2 id) {
    return (uint(id.x) * 92837111u + uint(id.y) * 689287499u) & (vertexHashTableSize - 1u);
}

uint packID(ivec2 id) {
    return id.x * 73856093u ^ id.y * 19349663u; // простой хеш-функция для ID
}

int flatCoord(ivec3 c) {
    return c.x + c.y * densityCountAxis + c.z * densityCountAxis * densityCountAxis;
}

uint getEdgeIndex(ivec3 coordA, ivec3 coordB) {
    /// max index is 774144
    ivec3 a = min(coordA, coordB);
    ivec3 b = max(coordA, coordB);
    ivec3 d = b - a;

    if (d == ivec3(1, 0, 0)) {
        // Рёбра по X: X ∈ [0..62], Y ∈ [0..63], Z ∈ [0..63]
        // Всего: 63 * 64 * 64 = 258,048
        return uint(a.z * densityCountAxis * densityCountAxis + a.y * densityCountAxis + a.x);
    }
    else if (d == ivec3(0, 1, 0)) {
        // Рёбра по Y: X ∈ [0..63], Y ∈ [0..62], Z ∈ [0..63]
        // Смещение: +258,048
        return uint(densityCountAxis * densityCountAxis * densityCountAxis
                    + a.z * densityCountAxis * densityCountAxis + a.y * densityCountAxis + a.x);
    }
    else if (d == ivec3(0, 0, 1)) {
        // Рёбра по Z: X ∈ [0..63], Y ∈ [0..63], Z ∈ [0..62]
        // Смещение: +258,048 + 258,048 = 516,096
        return uint(densityCountAxis * densityCountAxis * densityCountAxis    // X
                    + densityCountAxis * densityCountAxis * densityCountAxis  // Y
                    + a.z * densityCountAxis * densityCountAxis + a.y * densityCountAxis + a.x);
    }

    // Невалидное ребро — не соседняя вершина
    return 0;
}

int getOrInsertVertexHashTable(ivec3 coordA, ivec3 coordB) {
    uint idx = getEdgeIndex(coordA, coordB);
    return hashTable[idx];
}

void prepareHashTable(ivec3 coordA, ivec3 coordB) {
    uint idx = getEdgeIndex(coordA, coordB);
    uint index = atomicCompSwap(hashTable[idx], -1, 0);

    //if (index != -1) {
    //    return;
    //}

    int newIndex = int(atomicAdd(vertexCount, 1));
    vertices[newIndex] = createVertex(coordA, coordB);
    hashTable[idx] = newIndex;
}

void prepareTable(ivec3 coordA, ivec3 coordB) {
    ivec2 id = ivec2(hash3D(min(coordA, coordB)), computeEdgeCode(coordA, coordB));
    //ivec2 id = ivec2(flatCoord(min(coordA, coordB)), computeEdgeCode(coordA, coordB));

    uint key = packID(id);
    //uint key = getEdgeIndex(coordA, coordB);
    uint h = hashVertexID(id);

    if (key == EMPTY_KEY || key == RESERVED_MARKER) {
        return;
    }

    for (uint i = 0u; i < vertexHashTableSize; ++i) {
        uint idx = (h + i) & (vertexHashTableSize - 1u);
        uint storedKey = atomicCompSwap(vertexKeys[idx], EMPTY_KEY, RESERVED_MARKER);

        if (storedKey == RESERVED_MARKER || storedKey == key) {
            return;
        }

        if (storedKey == EMPTY_KEY) {
            int newIndex = int(atomicAdd(vertexCount, 1));
            vertices[newIndex] = createVertex(coordA, coordB);
            vertexValues[idx] = newIndex;
            vertexKeys[idx] = key;
            return;
        }
    }
}

int getOrInsertVertex(ivec3 coordA, ivec3 coordB) {
    //int indexA = indexFromCoord(coordA);
    //int indexB = indexFromCoord(coordB);
    //ivec2 id = ivec2(min(indexA, indexB), max(indexA, indexB));
    //ivec2 id = ivec2(flatCoord(min(coordA, coordB)), computeEdgeCode(coordA, coordB));
    ivec2 id = ivec2(hash3D(min(coordA, coordB)), computeEdgeCode(coordA, coordB));

    uint key = packID(id);
    //uint key = getEdgeIndex(coordA, coordB);
    if (key == EMPTY_KEY || key == RESERVED_MARKER) {
        return -1;
    }

    uint h = hashVertexID(id);

    for (uint i = 0u; i < vertexHashTableSize; ++i) {
        uint idx = (h + i) & (vertexHashTableSize - 1u);
        uint storedKey = atomicCompSwap(vertexKeys[idx], EMPTY_KEY, RESERVED_MARKER);

        if (storedKey == EMPTY_KEY) {
            int newIndex = int(atomicAdd(vertexCount, 1));
            vertices[newIndex] = createVertex(coordA, coordB);
            vertexValues[idx] = newIndex;
            vertexKeys[idx] = key;
            return newIndex;
        }

        if (storedKey == key) {
            return vertexValues[idx];
        }
        // Слот занят другим ключом или ещё не готов — идём дальше
    }

    return -1; // таблица переполнена
}

[[THREADS(8, 8, 8)]]
void compute() {
    ivec3 voxelPos = ivec3(GLOBAL_INVOCATION_ID.xyz);

    int cubeIndex = 0;
    ivec3 cornerCoords[8];
    for (int i = 0; i < 8; ++i) {
        cornerCoords[i] = voxelPos + cornerOffsets[i];
        if (GetDensity(cornerCoords[i]) < isoLevel) {
            cubeIndex |= (1 << i);
        }
    }

    int edgeFlags = edgeTable[cubeIndex];
    if (edgeFlags == 0) {
        return;
    }

    int[] edges = triangulation_official[cubeIndex];

    for (int i = 0; i < 15; i += 3) {
        int edgeIndexA = edges[i];
        if (edgeIndexA == -1) {
            break;
        }

        int edgeIndexB = edges[i + 1];
        int edgeIndexC = edges[i + 2];

        int a0 = cornerIndexAFromEdge[edgeIndexA];
        int a1 = cornerIndexBFromEdge[edgeIndexA];
        int b0 = cornerIndexAFromEdge[edgeIndexB];
        int b1 = cornerIndexBFromEdge[edgeIndexB];
        int c0 = cornerIndexAFromEdge[edgeIndexC];
        int c1 = cornerIndexBFromEdge[edgeIndexC];

        if (COMPUTE_STAGE == 1) {
            int indexA = getOrInsertVertex(cornerCoords[a0], cornerCoords[a1]);
            int indexB = getOrInsertVertex(cornerCoords[b0], cornerCoords[b1]);
            int indexC = getOrInsertVertex(cornerCoords[c0], cornerCoords[c1]);
            //if (indexA == -1 || indexB == -1 || indexC == -1) {
            //    return;
            //}

            //int indexA = getOrInsertVertexHashTable(cornerCoords[a0], cornerCoords[a1]);
            //int indexB = getOrInsertVertexHashTable(cornerCoords[b0], cornerCoords[b1]);
            //int indexC = getOrInsertVertexHashTable(cornerCoords[c0], cornerCoords[c1]);

            uint baseIndex = atomicAdd(indicesCount, 3);
            indices[baseIndex + 0] = uint(indexA);
            indices[baseIndex + 1] = uint(indexB);
            indices[baseIndex + 2] = uint(indexC);

            //indicesCount = 1;
        }
        else {
            prepareTable(cornerCoords[a0], cornerCoords[a1]);
            prepareTable(cornerCoords[b0], cornerCoords[b1]);
            prepareTable(cornerCoords[c0], cornerCoords[c1]);

             //prepareHashTable(cornerCoords[a0], cornerCoords[a1]);
             //prepareHashTable(cornerCoords[b0], cornerCoords[b1]);
             //prepareHashTable(cornerCoords[c0], cornerCoords[c1]);

             //int newIndex = int(atomicAdd(vertexCount, 3));
             //vertices[newIndex + 0] = createVertex(cornerCoords[a0], cornerCoords[a1]);
             //vertices[newIndex + 1] = createVertex(cornerCoords[b0], cornerCoords[b1]);
             //vertices[newIndex + 2] = createVertex(cornerCoords[c0], cornerCoords[c1]);
        }

        //Vertex vA = createVertex(cornerCoords[a0], cornerCoords[a1]);
        //Vertex vB = createVertex(cornerCoords[b0], cornerCoords[b1]);
        //Vertex vC = createVertex(cornerCoords[c0], cornerCoords[c1]);
        //uint baseIndex = atomicAdd(vertexCount, 3);
        //vertices[baseIndex + 0] = vA;
        //vertices[baseIndex + 1] = vB;
        //vertices[baseIndex + 2] = vC;
    }
}
