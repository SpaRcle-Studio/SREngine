[[const]] uint EMPTY_KEY = 0xFFFFFFFFu;
[[const]] uint RESERVED_MARKER = 0xFFFFFFFEu;

int getOrInsertVertex(ivec3 coordA, ivec3 coordB) {
    //ivec2 id = ivec2(hash3D(min(coordA, coordB)), computeEdgeCode(coordA, coordB));
    ivec2 id = ivec2(flatCoord(min(coordA, coordB)), computeEdgeCode(coordA, coordB));

    uint key = packID(id);
    uint h = hashVertexID(id);

    for (uint i = 0u; i < vertexHashTableSize; ++i) {
        uint idx = (h + i) & (vertexHashTableSize - 1u);
        uint storedKey = atomicCompSwap(vertexKeys[idx], EMPTY_KEY, RESERVED_MARKER);

        if (storedKey == EMPTY_KEY) {
            // Мы первые, вставляем вершину
            int newIndex = int(atomicAdd(vertexCount, 1));
            vertices[newIndex] = createVertex(coordA, coordB);
            vertexValues[idx] = newIndex;

            // Публикуем ключ
            vertexKeys[idx] = key;
            return newIndex;
        }

        memoryBarrier(); // Гарантируем, что ключ уже записан

        // Если уже кто-то вставил наш ключ
        if (storedKey == key || vertexKeys[idx] == key) {
            return vertexValues[idx];
        }

        // Слот занят другим ключом или ещё не готов — идём дальше
    }

    return -1; // таблица переполнена
}

[[THREADS(8, 8, 8)]]
void compute() {
    ivec3 voxelPos = ivec3(GLOBAL_INVOCATION_ID.xyz);

    int cubeIndex = 0;
    ivec3 cornerCoords[8];
    for (int i = 0; i < 8; ++i) {
        cornerCoords[i] = voxelPos + cornerOffsets[i];
        if (GetDensity(cornerCoords[i]) < isoLevel) {
            cubeIndex |= (1 << i);
        }
    }

    int edgeFlags = edgeTable[cubeIndex];
    if (edgeFlags == 0) {
        return;
    }

    int[] edges = triangulation_official[cubeIndex];

    for (int i = 0; i < 15; i += 3) {
        int edgeIndexA = edges[i];
        if (edgeIndexA == -1) {
            break;
        }

        int edgeIndexB = edges[i + 1];
        int edgeIndexC = edges[i + 2];

        int a0 = cornerIndexAFromEdge[edgeIndexA];
        int a1 = cornerIndexBFromEdge[edgeIndexA];
        int b0 = cornerIndexAFromEdge[edgeIndexB];
        int b1 = cornerIndexBFromEdge[edgeIndexB];
        int c0 = cornerIndexAFromEdge[edgeIndexC];
        int c1 = cornerIndexBFromEdge[edgeIndexC];

        int indexA = getOrInsertVertex(cornerCoords[a0], cornerCoords[a1]);
        int indexB = getOrInsertVertex(cornerCoords[b0], cornerCoords[b1]);
        int indexC = getOrInsertVertex(cornerCoords[c0], cornerCoords[c1]);
        uint baseIndex = atomicAdd(indicesCount, 3);
        indices[baseIndex + 0] = uint(indexA);
        indices[baseIndex + 1] = uint(indexB);
        indices[baseIndex + 2] = uint(indexC);

        //Vertex vA = createVertex(cornerCoords[a0], cornerCoords[a1]);
        //Vertex vB = createVertex(cornerCoords[b0], cornerCoords[b1]);
        //Vertex vC = createVertex(cornerCoords[c0], cornerCoords[c1]);
        //uint baseIndex = atomicAdd(vertexCount, 3);
        //vertices[baseIndex + 0] = vA;
        //vertices[baseIndex + 1] = vB;
        //vertices[baseIndex + 2] = vC;
    }
}
