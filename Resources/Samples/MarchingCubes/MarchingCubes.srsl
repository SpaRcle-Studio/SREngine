ShaderType Compute;

struct Vertex {
	vec3 position;
	vec3 normal;
	ivec2 id;
};

struct Triangle {
	Vertex c;
	Vertex b;
	Vertex a;
};

[[ssbo(triangles)]] uint count;
[[ssbo(triangles)]] Triangle[] triangles;

[[THREADS(2, 1, 1)]]
void compute() {
    uint index = atomicAdd(count, 1);

    triangles[index].a = Vertex(vec3(index + 1, 0.0, 0.0), vec3(0.0, 1.0, 0.0), ivec2(0, 0));
    triangles[index].b = Vertex(vec3(0.0, index + 1, 0.0), vec3(0.0, 1.0, 0.0), ivec2(0, 0));
    triangles[index].c = Vertex(vec3(0.0, 0.0, index + 1), vec3(0.0, 1.0, 0.0), ivec2(0, 0));
}