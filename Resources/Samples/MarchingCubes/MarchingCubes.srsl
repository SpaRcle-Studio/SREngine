ShaderType Compute;

struct Vertex {
	vec3 position;
	vec3 normal;
	ivec2 id;
};

struct Triangle {
	Vertex vertexC;
	Vertex vertexB;
	Vertex vertexA;
};

[[ssbo(triangles)]] Triangle[] triangles;

[[THREADS(2, 2, 2)]]
void compute() {
    triangles[0] = Triangle(
        Vertex(vec3(0.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0), ivec2(0, 0)),
        Vertex(vec3(1.0, 0.0, 0.0), vec3(1.0, 1.0, 0.0), ivec2(1, 0)),
        Vertex(vec3(1.0, 1.0, 0.0), vec3(1.0, 1.0, 1.0), ivec2(1, 1))
    );
}