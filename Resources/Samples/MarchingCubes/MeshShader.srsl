ShaderType Spatial;

PolygonMode Fill;
CullMode Back;
DepthCompare LessOrEqual;
PrimitiveTopology TriangleList;
BlendEnabled false;
DepthWrite true;
DepthTest true;

[[uniform], [public]] vec4 color = vec4(1, 1, 1, 1);
[[uniform], [public]] sampler2D diffuse;

[[uniform], [public]] int densityCountAxis = 0;
[[uniform], [public]] ivec3 chunkCoord = ivec3(0, 0, 0);

///[[shared]] vec3 vNormal;

#include <Engine/Shaders/CascadedShadowMap/pcf-utils.inl.srsl>

void fragment() {
    vec3 diffuseColor = texture(diffuse, UV).rgb * color.rgb;

    vec3 lightColor = vec3(1.0);
    vec3 lightDir = normalize(vec3(0.5, 1.0, 0.3));

    vec3 offset = vec3(chunkCoord) * vec3(float(densityCountAxis));
    COLOR = CalculateShadowCustom(diffuseColor, lightColor, VERTEX + offset);

    //vec3 norm = normalize(vNormal);
    //float diff = max(dot(norm, lightDir), 0.0); // ламбертово затенение
    //vec3 color = diffuseColor * lightColor * diff;

    //COLOR = vec4(vNormal * 0.5 + 0.5, 1.0); // мапим от [-1..1] → [0..1]
    //COLOR = vec4(color, 1.0);
}

void vertex() {
    vec3 offset = vec3(chunkCoord) * vec3(float(densityCountAxis));
    PreparePCFCustom(MODEL_MATRIX, VERTEX + offset, NORMAL);
    //vNormal = mat3(transpose(inverse(MODEL_MATRIX))) * NORMAL; // нормали в мировом пространстве
    OUT_POSITION = PROJECTION_MATRIX * VIEW_MATRIX * MODEL_MATRIX * vec4(VERTEX, 1.0);
}