sra format
use tabs: true
0-r:Root
	1-o:asset
		2-v:type
			3-s:FileRenderTechniquePresetResource
		2-o:ptr
			3-a:layers
				4-k:i
					5-o:d
						6-v:type
							7-s:RenderTechniqueLayerMesh
						6-o:ptr
							7-a:allowedLayers
								8-k:i
									9-v:d
										10-s:Default
								8-k:i
									9-v:d
										10-s:Opaque
							7-a:disallowedLayers
							7-v:castShadows
								8-b:true
							7-v:colorBuffer
								8-b:true
				4-k:i
					5-o:d
						6-v:type
							7-s:RenderTechniqueLayerSkybox
						6-o:ptr
				4-k:i
					5-o:d
						6-v:type
							7-s:RenderTechniqueLayerMesh
						6-o:ptr
							7-a:allowedLayers
								8-k:i
									9-v:d
										10-s:TransparentSecond
								8-k:i
									9-v:d
										10-s:Transparent
							7-a:disallowedLayers
							7-v:castShadows
								8-b:true
							7-v:colorBuffer
								8-b:true
				4-k:i
					5-o:d
						6-v:type
							7-s:RenderTechniqueLayerClearDepth
						6-o:ptr
							7-v:editorOnly
								8-b:true
			3-a:integrations
				4-k:i
					5-o:d
						6-v:type
							7-s:RenderTechniquePresetIntegrationColorBuffer
						6-o:ptr
				4-k:i
					5-o:d
						6-v:type
							7-s:RenderTechniquePresetIntegrationShadows
						6-o:ptr
							7-a:specialShadowLayers
				4-k:i
					5-o:d
						6-v:type
							7-s:RenderTechniquePresetIntegrationMainView
						6-o:ptr
							7-o:defaultPostProcessPass
								8-v:type
									9-s:PostProcessPass
								8-o:ptr
									9-o:samplers
										10-a:samplers
											11-k:i
												12-o:d
													13-v:id
														14-s:colorMap
													13-v:usageType
														14-s:FrameBufferColor
													13-v:fboName
														14-s:Offscreen
									9-o:material
										10-v:type
											11-s:UniqueMaterial
										10-o:ptr
											11-o:data
												12-v:type
													13-s:MaterialData
												12-o:ptr
													13-a:shaderDefines
													13-o:defaultShader
														14-v:shaderPath
															15-s:Engine/Shaders/PostProcess/default.srsl
