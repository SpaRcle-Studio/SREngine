sra format
0-r:Root
	1-o:default
		2-v:shader
			3-s:Engine/Shaders/SSAO/ssao_geometry.srsl
		2-o:data
			3-a:uniforms
				4-k:i
					5-o:d
						6-v:id
							7-s:color
						6-v:type
							7-s:Vec4
						6-o:value
							7-v:x
								8-f:1.000000
							7-v:y
								8-f:1.000000
							7-v:z
								8-f:1.000000
							7-v:w
								8-f:1.000000
			3-a:samplers
				4-k:i
					5-o:d
						6-v:id
							7-s:diffuse
						6-v:type
							7-s:Sampler2D
						6-v:value
							7-s:Engine/Textures/default_improved.png
	1-a:stages
		2-k:stage
			3-v:id
				4-s:Shadow
			3-v:shader
				4-s:Engine/Shaders/CascadedShadowMap/spatial.srsl
			3-o:data
				4-a:uniforms
					5-k:i
						6-o:d
							7-v:id
								8-s:color
							7-v:type
								8-s:Vec4
							7-o:value
								8-v:x
									9-f:1.000000
								8-v:y
									9-f:1.000000
								8-v:z
									9-f:1.000000
								8-v:w
									9-f:1.000000
				4-a:samplers
					5-k:i
						6-o:d
							7-v:id
								8-s:diffuse
							7-v:type
								8-s:Sampler2D
							7-v:value
								8-s:Engine/Textures/default_improved.png
