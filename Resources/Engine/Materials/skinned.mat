sra format
0-r:Root
	1-o:asset
		2-v:type
			3-s:FileMaterialResource
		2-o:ptr
			3-o:data
				4-v:type
					5-s:MaterialData
				4-o:ptr
					5-o:default
						6-v:shader
							7-s:Engine/Shaders/CascadedShadowMap/skinned.srsl
						6-o:data
							7-a:uniforms
								8-k:i
									9-o:d
										10-v:id
											11-s:color
										10-v:type
											11-s:Vec4
										10-o:value
											11-v:x
												12-f:1.000000
											11-v:y
												12-f:1.000000
											11-v:z
												12-f:1.000000
											11-v:w
												12-f:1.000000
							7-a:samplers
								8-k:i
									9-o:d
										10-v:id
											11-s:diffuse
										10-v:type
											11-s:Sampler2D
										10-v:value
											11-s:Engine/Textures/default_improved.png
					5-a:stages
						6-k:stage
							7-v:id
								8-s:Shadow
							7-v:shader
								8-s:Engine/Shaders/CascadedShadowMap/skinned.srsl
							7-o:data
								8-a:uniforms
									9-k:i
										10-o:d
											11-v:id
												12-s:color
											11-v:type
												12-s:Vec4
											11-o:value
												12-v:x
													13-f:1.000000
												12-v:y
													13-f:1.000000
												12-v:z
													13-f:1.000000
												12-v:w
													13-f:1.000000
								8-a:samplers
									9-k:i
										10-o:d
											11-v:id
												12-s:diffuse
											11-v:type
												12-s:Sampler2D
											11-v:value
												12-s:Engine/Textures/default_improved.png