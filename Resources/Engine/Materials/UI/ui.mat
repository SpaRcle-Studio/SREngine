sra format
0-r:Root
	1-o:asset
		2-v:type
			3-s:FileMaterialResource
		2-o:ptr
			3-o:data
				4-v:type
					5-s:MaterialData
				4-o:ptr
					5-o:default
						6-v:shader
							7-s:Engine/Shaders/ui.srsl
						6-o:data
							7-a:uniforms
								8-k:i
									9-o:d
										10-v:id
											11-s:color
										10-v:type
											11-s:Vec4
										10-o:value
											11-v:x
												12-f:1.000000
											11-v:y
												12-f:1.000000
											11-v:z
												12-f:1.000000
											11-v:w
												12-f:1.000000
							7-a:samplers
								8-k:i
									9-o:d
										10-v:id
											11-s:diffuse
										10-v:type
											11-s:Sampler2D
										10-v:value
											11-s:Engine/Textures/default_improved.png