							7-k:i
								8-o:d
									9-v:id
										10-s:color
									9-v:type
										10-s:Vec4
									9-o:value
										10-v:x
											11-f:1
										10-v:y
											11-f:1
										10-v:z
											11-f:1
										10-v:w
											11-f:1
