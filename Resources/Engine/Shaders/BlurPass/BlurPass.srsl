ShaderType PostProcessing;

PolygonMode Fill;
CullMode Back;
DepthCompare LessOrEqual;
PrimitiveTopology TriangleList;
BlendEnabled false;
DepthWrite false;
DepthTest false;


[[shared]] vec2 uv;
[[uniform]] sampler2D image;

#define USE_COLOR_INDEX_0

void fragment() {
    vec2 texelSize = 1.0 / vec2(textureSize(image, 0));

    float result = 0.0;

    int radius = 8;
    for (int x = -radius; x < radius; ++x)
    {
        for (int y = -radius; y < radius; ++y)
        {
            vec2 offset = vec2(float(x), float(y)) * texelSize;

            float value = texture(image, uv + offset).r;
            result += value;
        }
    }

    result /= float((radius * 2) * (radius * 2));

    COLOR_INDEX_0 = vec4(vec3(result), 1.0);
}

void vertex() {
    uv = vec2((VERTEX_INDEX << 1) & 2, VERTEX_INDEX & 2);
    OUT_POSITION = vec4(uv * 2.0 - 1.0, 0.0, 1.0);
}