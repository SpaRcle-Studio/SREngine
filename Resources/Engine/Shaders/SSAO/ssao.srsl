ShaderType PostProcessing;

PolygonMode Fill;
CullMode Back;
DepthCompare LessOrEqual;
PrimitiveTopology TriangleList;
BlendEnabled false;
DepthWrite false;
DepthTest false;

float LinearEyeDepth(float depth, float near, float far) {
    float z = depth * 2.0 - 1.0;                // обратно в clip space (-1..1)
    return (2.0 * near * far) / (far + near - z * (far - near));
}


[[shared]] vec2 uv;
[[uniform]] sampler2D Depth;
[[uniform]] sampler2D Normal;
[[uniform]] sampler2D Position;
[[uniform]] sampler2D Noise;

[[ssbo(SSAOKernel)]] vec4[] samples;



#define USE_COLOR_INDEX_0

void fragment() {

    vec3 posWS = texture(Position, uv).xyz;
    vec3 normal = texture(Normal, uv).rgb;
    //normal = normalize(normal * 2.0 - 1.0);

    vec3 pos = (VIEW_MATRIX * vec4(posWS, 1.0)).xyz;
    //vec3 normal = normalize((VIEW_MATRIX * vec4(normalWS, 0.0)).xyz);

    float occlusion = 0.0;
    float radius = 0.5;
    float bias = 0.025;

    vec2 noiseScale = vec2(RESOLUTION.x / 4.0, RESOLUTION.y / 4.0);

    /*vec3 up = abs(normal.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, normal));
    vec3 bitangent = cross(normal, tangent);
    mat3 TBN = mat3(tangent, bitangent, normal);
    */

    vec3 noiseV = vec3(texture(Noise, uv * noiseScale).xy, 0.0);
    vec3 randomVec = normalize(noiseV * 2.0 - 1.0);
    vec3 tangent = normalize(randomVec - normal * dot(randomVec, normal));
    vec3 bitangent = cross(normal, tangent);
    mat3 TBN = mat3(tangent, bitangent, normal);

    for(int i = 0; i < 64; i++){
        /*
        //float scale = float(i) / 8.0;
        //scale = mix(0.1, 1.0, scale * scale);


        vec3 sampleDir = TBN * SSAOKernel[i].xyz;
        vec3 samplePos = pos + sampleDir * radius;//* scale;

        vec4 clipPos = PROJECTION_MATRIX * vec4(samplePos, 1.0);

        if (clipPos.w <= 0.0001){
            continue;
        }

        clipPos.xyz /= clipPos.w;

        vec2 sampleUV = clipPos.xy * 0.5 + 0.5;

        if(sampleUV.x < 0.0 || sampleUV.x > 1.0 ||
           sampleUV.y < 0.0 || sampleUV.y > 1.0){
            continue;
        }

        float d = 1.0 - texture(Depth, uv).r;
        float s = 1.0 - texture(Depth, sampleUV).r;
        float sampleDepth = LinearEyeDepth(s,CAMERA_NEAR, CAMERA_FAR);
        float centerDepth = LinearEyeDepth(d, CAMERA_NEAR, CAMERA_FAR);

        //float range = abs(centerDepth - sampleDepth);
        //float rangeCheck = smoothstep(0.0, 1.0, radius / max(range, 0.001));

        if(sampleDepth >= centerDepth + bias){
            occlusion += 1.0; //rangeCheck;
        }
        */

        // get sample position
        vec3 samplePos = TBN * samples[i].xyz; // from tangent to view-space
        samplePos = pos + samplePos * radius;

        // project sample position (to sample texture) (to get position on screen/texture)
        vec4 offset = vec4(samplePos, 1.0);
        offset = PROJECTION_MATRIX * offset; // from view to clip-space
        offset.xyz /= offset.w; // perspective divide
        offset.xyz = offset.xyz * 0.5 + 0.5; // transform to range 0.0 - 1.0

        // get sample depth
        //(VIEW_MATRIX * vec4(texture(Position, offset.xy).xyz, 1.0)).z;
        float sampleDepth = (VIEW_MATRIX * vec4(texture(Position, offset.xy).xyz, 1.0)).z; // get depth value of kernel sample

        // range check & accumulate
        float rangeCheck = smoothstep(0.0, 1.0, radius / abs(pos.z - sampleDepth));
        occlusion += (sampleDepth >= samplePos.z + bias ? 1.0 : 0.0) * rangeCheck;
    }
    float depth = texture(Depth, uv).r;

    occlusion = 1.0 - (occlusion / 64.0);
    COLOR_INDEX_0 = vec4(vec3(occlusion), 1.0);
}

void vertex() {
    uv = vec2((VERTEX_INDEX << 1) & 2, VERTEX_INDEX & 2);
    OUT_POSITION = vec4(uv * 2.0 - 1.0, 0.0, 1.0);
}