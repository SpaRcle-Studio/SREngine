ShaderType PostProcessing;

PolygonMode Fill;
CullMode Back;
DepthCompare LessOrEqual;
PrimitiveTopology TriangleList;
BlendEnabled false;
DepthWrite false;
DepthTest false;

// Один шаг цепочки bloom (см. RenderTechniquePresetIntegrationBloom).
// Сэмплеры кадровых буферов в движке NEAREST, поэтому вся фильтрация сделана вручную выборками в центры текселей.

[[uniform(SHARED)]] vec4 bloomParams;        // threshold, knee (доля от threshold), clampMax, -
[[uniform(SHARED)]] vec4 bloomCombineParams; // scatter, -, -, -

#if defined(SR_BLOOM_PREFILTER) || defined(SR_BLOOM_DOWNSAMPLE)
    [[uniform]] sampler2D bloomSource;
#endif

#ifdef SR_BLOOM_UPSAMPLE
    [[uniform]] sampler2D bloomLow;
    [[uniform]] sampler2D bloomHigh;
#endif

#ifdef SR_BLOOM_EXPOSURE
    [[ssbo(exposure)]] float[] exposure;
#endif

[[shared]] vec2 uv;

#define USE_COLOR_INDEX_0

float bloomLuma(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

#if defined(SR_BLOOM_PREFILTER) || defined(SR_BLOOM_DOWNSAMPLE)
    vec3 fetchSource(vec2 texel, vec2 sourceSize) {
        vec3 c = textureLod(bloomSource, texel / sourceSize, 0.0).rgb;
        // NaN/Inf и отрицательные значения из сцены не должны попасть в цепочку
        return clamp(c, vec3(0.0), vec3(65000.0));
    }

    // Фильтр уменьшения. HQ: tent 4x4 (веса 1-3-3-1) - антиалиасинг и стабильность при движении камеры.
    // LQ: box 2x2. karis = 1 - вес 1 / (1 + luma) на выборку, гасит одиночные яркие пиксели (светлячки).
    // Prefilter всегда идет через 4x4: от него зависит мерцание всей цепочки, а считается он один раз.
    vec3 downsample(vec2 coord, float karis) {
        vec2 sourceSize = vec2(textureSize(bloomSource, 0));
        vec2 center = coord * sourceSize;

        vec3 result = vec3(0.0);
        float weightSum = 0.0;

    #if defined(SR_BLOOM_HQ) || defined(SR_BLOOM_PREFILTER)
        for (int y = 0; y < 4; y++) {
            for (int x = 0; x < 4; x++) {
                vec2 offset = vec2(float(x) - 1.5, float(y) - 1.5);
                float wx = 3.0;
                if (x == 0 || x == 3) { wx = 1.0; }
                float wy = 3.0;
                if (y == 0 || y == 3) { wy = 1.0; }
                vec3 c = fetchSource(floor(center + offset) + 0.5, sourceSize);
                float w = wx * wy;
                if (karis > 0.5) {
                    w = w / (1.0 + bloomLuma(c));
                }
                result += c * w;
                weightSum += w;
            }
        }
    #else
        for (int y = 0; y < 2; y++) {
            for (int x = 0; x < 2; x++) {
                vec2 offset = vec2(float(x) - 0.5, float(y) - 0.5);
                vec3 c = fetchSource(floor(center + offset) + 0.5, sourceSize);
                float w = 1.0;
                if (karis > 0.5) {
                    w = 1.0 / (1.0 + bloomLuma(c));
                }
                result += c * w;
                weightSum += w;
            }
        }
    #endif

        return result / max(weightSum, 1e-6);
    }
#endif

#ifdef SR_BLOOM_UPSAMPLE
    vec3 fetchTexel(sampler2D tex, vec2 texel, vec2 size) {
        return textureLod(tex, texel / size, 0.0).rgb;
    }

    // Увеличение нижнего уровня. HQ: кубический B-spline 4x4 - гладкий, без ромбов и ступенек билинейки.
    // LQ: билинейная интерполяция по 4 текселям.
    vec3 upsample(sampler2D tex, vec2 coord) {
        vec2 size = vec2(textureSize(tex, 0));
        vec2 pixel = coord * size - 0.5;
        vec2 base = floor(pixel);
        vec2 f = pixel - base;

    #ifdef SR_BLOOM_HQ
        vec2 f2 = f * f;
        vec2 f3 = f2 * f;
        vec2 w0 = (1.0 - 3.0 * f + 3.0 * f2 - f3) / 6.0;
        vec2 w1 = (4.0 - 6.0 * f2 + 3.0 * f3) / 6.0;
        vec2 w2 = (1.0 + 3.0 * f + 3.0 * f2 - 3.0 * f3) / 6.0;
        vec2 w3 = f3 / 6.0;

        vec3 result = vec3(0.0);
        for (int y = 0; y < 4; y++) {
            float wy = w0.y;
            if (y == 1) { wy = w1.y; }
            if (y == 2) { wy = w2.y; }
            if (y == 3) { wy = w3.y; }
            for (int x = 0; x < 4; x++) {
                float wx = w0.x;
                if (x == 1) { wx = w1.x; }
                if (x == 2) { wx = w2.x; }
                if (x == 3) { wx = w3.x; }
                vec2 texel = base + vec2(float(x) - 1.0, float(y) - 1.0) + 0.5;
                result += fetchTexel(tex, texel, size) * (wx * wy);
            }
        }
        return result;
    #else
        vec3 c00 = fetchTexel(tex, base + vec2(0.5, 0.5), size);
        vec3 c10 = fetchTexel(tex, base + vec2(1.5, 0.5), size);
        vec3 c01 = fetchTexel(tex, base + vec2(0.5, 1.5), size);
        vec3 c11 = fetchTexel(tex, base + vec2(1.5, 1.5), size);
        return mix(mix(c00, c10, f.x), mix(c01, c11, f.x), f.y);
    #endif
    }
#endif

void fragment() {
#ifdef SR_BLOOM_PREFILTER
    vec3 color = downsample(uv, 1.0);

    // порог считается по экспонированной яркости - bloom не зависит от абсолютной освещенности сцены
    #ifdef SR_BLOOM_EXPOSURE
        float exposureValue = max(exposure[0], 1e-4);
    #else
        float exposureValue = 0.6;
    #endif

    color = min(color * exposureValue, vec3(bloomParams.z));

    // мягкий порог (quadratic knee)
    float threshold = bloomParams.x;
    float knee = threshold * bloomParams.y + 1e-4;
    float brightness = max(color.r, max(color.g, color.b));
    float soft = clamp(brightness - threshold + knee, 0.0, 2.0 * knee);
    soft = soft * soft / (4.0 * knee);
    float contribution = max(soft, brightness - threshold) / max(brightness, 1e-4);

    // храним в единицах сцены, экспозиция применится в post-process вместе с основным цветом
    COLOR_INDEX_0 = vec4(color * contribution / exposureValue, 1.0);
#endif

#ifdef SR_BLOOM_DOWNSAMPLE
    COLOR_INDEX_0 = vec4(downsample(uv, 0.0), 1.0);
#endif

#ifdef SR_BLOOM_UPSAMPLE
    vec3 high = textureLod(bloomHigh, uv, 0.0).rgb;
    vec3 low = upsample(bloomLow, uv);
    COLOR_INDEX_0 = vec4(mix(high, low, bloomCombineParams.x), 1.0);
#endif
}

void vertex() {
    uv = vec2(float((VERTEX_INDEX << 1) & 2), float(VERTEX_INDEX & 2));
    OUT_POSITION = vec4(uv * 2.0 - 1.0, 0.0, 1.0);
}
