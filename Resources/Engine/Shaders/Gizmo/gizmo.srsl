ShaderType Spatial;

PolygonMode Fill;
CullMode Back;
DepthCompare LessOrEqual;
PrimitiveTopology TriangleList;
DepthWrite true;

#ifdef SR_DEFINE_COLOR_PASS
    BlendEnabled true;
    DepthTest false;
#else
    BlendEnabled false;
    DepthTest true;
#endif

[[uniform], [public]] vec4 color;
[[uniform], [public]] bool useOrthogonal;

void fragment() {
	COLOR = color;
    COLOR_INDEX_1 = vec4(gl_FragCoord.z);
    COLOR_INDEX_2 = vec4(VERTEX, 1.0);
}

void vertex() {
    if (useOrthogonal == 1) {
        VERTEX = (MODEL_MATRIX * vec4(VERTEX + vec3(0, 0, 5), 1.0)).xyz;
        OUT_POSITION = ORTHOGONAL_MATRIX * vec4(VERTEX, 1.0);
    }
    else {
        VERTEX = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
        OUT_POSITION = PROJECTION_MATRIX * VIEW_MATRIX * vec4(VERTEX, 1.0);
    }
}