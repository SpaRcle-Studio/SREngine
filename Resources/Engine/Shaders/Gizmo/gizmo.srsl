ShaderType Spatial;

PolygonMode Fill;
CullMode Back;
DepthCompare LessOrEqual;
PrimitiveTopology TriangleList;
DepthWrite true;

#ifdef SR_DEFINE_COLOR_PASS
    BlendEnabled true;
    DepthTest false;
#else
    BlendEnabled false;
    #ifdef USE_ORTHOGONAL
        DepthTest false;
    #else
        DepthTest true;
    #endif
#endif

[[uniform], [public]] vec4 color;

void fragment() {
	COLOR = color;
    COLOR_INDEX_1 = vec4(gl_FragCoord.z);
    COLOR_INDEX_2 = vec4(VERTEX, 1.0);
    COLOR_INDEX_3 = vec4(NORMAL, 1.0);
}

void vertex() {
    mat4 orthogonalMat = ORTHOGONAL_MATRIX;
    mat4 viewMat = VIEW_MATRIX;
    mat4 projMat = PROJECTION_MATRIX;

    #ifdef USE_ORTHOGONAL
        VERTEX = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
        OUT_POSITION = orthogonalMat * vec4(VERTEX, 1.0);
    #else
        VERTEX = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
        OUT_POSITION = projMat * viewMat * vec4(VERTEX, 1.0);
    #endif
}