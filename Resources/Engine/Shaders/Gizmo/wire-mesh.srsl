ShaderType Simple;

PolygonMode Line;
CullMode Back;
DepthCompare LessOrEqual;
PrimitiveTopology LineList;
BlendEnabled true;
DepthWrite true;
DepthTest true;

void fragment() {
	COLOR = RGBA_VALUE;
    COLOR_INDEX_1 = vec4(1.0, 0.0, 0.0, COLOR.a);
    COLOR_INDEX_2 = vec4(VERTEX, COLOR.a);
    COLOR_INDEX_3 = vec4(0.5, 0.5, 0.5, COLOR.a);
}

void vertex() {
    VERTEX = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
    OUT_POSITION = PROJECTION_MATRIX * VIEW_MATRIX * vec4(VERTEX, 1.0);
}