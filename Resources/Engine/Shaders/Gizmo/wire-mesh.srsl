ShaderType Simple;

PolygonMode Line;
CullMode Back;
DepthCompare LessOrEqual;
PrimitiveTopology LineList;
BlendEnabled false;
DepthWrite true;
DepthTest true;

void fragment() {
	COLOR = RGBA_VALUE;
}

void vertex() {
    OUT_POSITION = PROJECTION_MATRIX * VIEW_MATRIX * MODEL_MATRIX * vec4(VERTEX, 1.0);
}