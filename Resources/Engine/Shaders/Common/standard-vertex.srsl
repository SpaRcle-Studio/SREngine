[[shared]] mat3 TBN;

void vertex() {
#ifdef HAS_SKELETON
    #include <Engine/Shaders/Common/bone-transform.inl.srsl>
    mat4 modelMatrix = boneTransform;
#else
    mat4 modelMatrix = MODEL_MATRIX;
#endif

#ifdef SR_STANDARD_VERTEX_POSITION_FUNC
    VERTEX = (modelMatrix * vec4(CalculateVertexPosition(), 1.0)).xyz;
#else
    VERTEX = (modelMatrix * vec4(VERTEX, 1.0)).xyz;
#endif

#ifdef SR_DEFINE_CASCADED_SHADOW_MAP_PASS
    #include <Engine/Shaders/Common/apply-cascades-transform.inl.srsl>
#else
    #ifdef SR_DEFINE_USE_CASCADED_SHADOW_MAP
        PreparePCF();
    #endif

    OUT_POSITION = PROJECTION_MATRIX * VIEW_MATRIX * vec4(VERTEX, 1.0);

    #ifndef SR_DEFINE_COLOR_PASS
        mat3 normalMatrix = transpose(inverse(mat3(modelMatrix)));
        NORMAL = normalize(normalMatrix * NORMAL);

        vec3 N = NORMAL;

        vec3 T = normalize(normalMatrix * TANGENT.xyz);
        //vec3 T = normalize(mat3(modelMatrix) * TANGENT.xyz);
        //vec3 B = normalize(cross(N, T)) * TANGENT.w;
        T = normalize(T - N * dot(N, T)); /// orthogonalize tangent

        vec3 B = cross(N, T) * TANGENT.w;
        TBN = mat3(T, B, N);

        /*
            mat3 model3x3 = mat3(modelMatrix);
            mat3 normalMatrix = transpose(inverse(model3x3));

            NORMAL = normalize(normalMatrix * NORMAL);

            vec3 N = NORMAL;

            // Tangent преобразуем обычной Model Matrix.
            vec3 T = normalize(model3x3 * TANGENT.xyz);

            // Ортогонализация относительно нормали.
            T = normalize(T - N * dot(N, T));

            // Учитываем отражение системы координат при отрицательном масштабе.
            float handedness = TANGENT.w * sign(determinant(model3x3));

            vec3 B = normalize(cross(N, T)) * handedness;

            TBN = mat3(T, B, N);
        */
    #endif
#endif
}