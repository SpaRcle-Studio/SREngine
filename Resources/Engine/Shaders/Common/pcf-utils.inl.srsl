    float ndotl = clamp(dot(norm, normalize(DIRECTIONAL_LIGHT_DIRECTION)), 0.0, 1.0);
    float cascadeBias[4] = { 0.0003, 0.0008, 0.0015, 0.003 };
    //float bias = cascadeBias[cascadeIndex] * (1.0 - ndotl);

    //bias += 0.0005;

    float bias = max(
        cascadeBias[cascadeIndex] * (1.0 - ndotl),
        cascadeBias[cascadeIndex] * 0.25
    );

    //bias += 0.0005;

    float dzdx = dFdx(sc.z);
    float dzdy = dFdy(sc.z);
    float receiverBias = max(abs(dzdx), abs(dzdy));

    bias += receiverBias * 2.0;   // коэффициент подбирается
    //bias += 0.0002;               // маленький safety
    bias += 0.015;               // маленький safety

    float depth = texture(shadowMap, vec3(uv, cascadeIndex)).r;
    return depth < sc.z - bias ? 0.0 : 1.0;*/

    /*// perspective divide
    vec3 proj = shadowCoord.xyz / shadowCoord.w;
