    if (shadowCoord.z > -1.0 && shadowCoord.z < 1.0) {
    	float dist = texture(shadowMap, vec3(shadowCoord.st + offset, cascadeIndex)).r;
    	if (shadowCoord.w > 0 && dist < shadowCoord.z - bias) {
    		shadow = 0.2;
    	}
    }
    return shadow;

