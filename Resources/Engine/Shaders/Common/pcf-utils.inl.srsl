    }
    return 0.0;*/
}

float filterPCF(vec3 norm, vec4 sc, uint cascadeIndex) {
	ivec2 texDim = textureSize(shadowMap, 0).xy;

	float cascadeScale[4] = { 1.5, 1.0, 0.7, 0.4 };
    float scale = cascadeScale[cascadeIndex];
    int range = (cascadeIndex == 0) ? 2 : 1;

	float dx = scale * 1.0 / float(texDim.x);
	float dy = scale * 1.0 / float(texDim.y);

	float shadowFactor = 0.0;
	int count = 0;

	for (int x = -range; x <= range; x++)
	{
		for (int y = -range; y <= range; y++)
		{
			shadowFactor += textureProj(sc, norm, vec2(dx * x, dy * y), cascadeIndex);
			count++;
		}
	}

	return shadowFactor / count;
}

vec4 CalculateShadow(vec3 diffuseColor, vec3 lightColor, float specularSharpness, float specularIntensity, float ambientIntensity, float shadowIntensity, float diffuseMin) {
#ifdef HAS_NORMAL
    vec3 N = normalize(NORMAL);
    vec3 T = normalize(TANGENT);
    // TODO: доработать расчет B
    // vec3 B = normalize(cross(N, T));
    // vec3 B = cross(N, T) * tangentW; // где tangentW = ±1
    vec3 B = normalize(BITANGENT);
    mat3 TBN = mat3(T, B, N);

    vec3 tangentNormal = texture(normal, UV).xyz * 2.0 - 1.0;
    vec3 norm = normalize(TBN * tangentNormal);
#else
    vec3 norm = NORMAL;
#endif

    int NUM_CASCADES = 4;
    int SHADOW_MAP_RESOLUTION = 4096;

    uint cascadeIndex = 0;
    for (uint i = 0; i < NUM_CASCADES - 1; ++i) {
        if (pcf_viewPos.z < CASCADE_SPLITS[i]) {
            cascadeIndex = i + 1;
        }
    }

    //uint cascadeIndex = 0;
    //for (uint i = 0; i < NUM_CASCADES - 1; ++i) {
    //    if (pcf_viewPos.z < CASCADE_SPLITS[i]) {
    //        cascadeIndex = i;
    //        break;
    //    }
    //}

    float cascadeBlend = 0.0;
    if (cascadeIndex < NUM_CASCADES - 1) {
        float splitNear = (cascadeIndex == 0) ? 0.0 : CASCADE_SPLITS[cascadeIndex - 1];
        float splitFar  = CASCADE_SPLITS[cascadeIndex];
        float fade = (splitFar - splitNear) * 0.1; // 10%

        cascadeBlend = smoothstep(
            splitFar - fade,
            splitFar,
            pcf_viewPos.z
        );
    }

    vec4 sc0 = biasMat * CASCADE_LIGHT_SPACE_MATRICES[cascadeIndex] * vec4(VERTEX, 1.0);
    float s0 = filterPCF(norm, sc0, cascadeIndex);

    float shadow = s0;

    if (cascadeBlend > 0.0 && cascadeIndex + 1 < NUM_CASCADES) {
        vec4 sc1 = biasMat * CASCADE_LIGHT_SPACE_MATRICES[cascadeIndex + 1] * vec4(VERTEX, 1.0);
        float s1 = filterPCF(norm, sc1, cascadeIndex + 1);
        shadow = mix(s0, s1, cascadeBlend);
    }

    //vec4 shadowCoord = (biasMat * CASCADE_LIGHT_SPACE_MATRICES[cascadeIndex]) * vec4(VERTEX, 1.0);
    //float shadow = filterPCF(norm, shadowCoord / shadowCoord.w, cascadeIndex);
	shadow = mix(1.0, shadow, shadowIntensity);

    vec3 ambient = ambientIntensity * 0.15 * diffuseColor;

    float ndotl = dot(normalize(DIRECTIONAL_LIGHT_DIRECTION), norm);
    float diffuseTerm = max(ndotl, diffuseMin);
    vec3 diff = diffuseTerm * lightColor;

    vec3 halfwayDir = normalize(DIRECTIONAL_LIGHT_DIRECTION + normalize(pcf_viewDir));
    float spec = pow(max(dot(norm, halfwayDir), 0.0), specularSharpness * 64) * specularIntensity;
    vec3 specular = spec * lightColor;

    vec4 color = vec4(ambient + shadow * (diff + specular) * diffuseColor, 1.0);

#ifdef SR_DEFINE_DEBUG_CASCADED_SHADOW_MAP_PASS
    return DebugColorCascade(color, cascadeIndex);
#else
    return color;
#endif
}

void PreparePCF(mat4 modelMatrix) {
    mat3 normalMatrix = transpose(inverse(mat3(modelMatrix)));
#ifdef HAS_NORMAL
    TANGENT = normalize(normalMatrix * TANGENT);
    BITANGENT = normalize(normalMatrix * BITANGENT);
#endif
    NORMAL = normalize(normalMatrix * NORMAL);

    pcf_viewDir = VIEW_POSITION - VERTEX;
    pcf_viewPos = (VIEW_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

vec4 CalculateShadowCustom(vec3 diffuseColor, vec3 lightColor, vec3 vertexPos, float specularSharpness, float specularIntensity, float ambientIntensity, float shadowIntensity, float diffuseMin) {
    uint cascadeIndex = 0;

    for (uint i = 0; i < 3; ++i) {
        if (pcf_viewPos.z < CASCADE_SPLITS[i]) {
            cascadeIndex = i + 1;
        }
    }

    vec4 shadowCoord = (biasMat * CASCADE_LIGHT_SPACE_MATRICES[cascadeIndex]) * pcf_modelMatrix * vec4(vertexPos, 1.0);

	float shadow = filterPCF(shadowCoord / shadowCoord.w, cascadeIndex) * shadowIntensity;

    vec3 ambient = ambientIntensity * 0.15 * diffuseColor;
    vec3 diff = max(dot(normalize(DIRECTIONAL_LIGHT_DIRECTION), normalize(pcf_normal)), diffuseMin) * lightColor;

    vec3 halfwayDir = normalize(DIRECTIONAL_LIGHT_DIRECTION + normalize(pcf_viewDir));
    float spec = pow(max(dot(normalize(pcf_normal), halfwayDir), 0.0), specularSharpness * 64) * specularIntensity;
    vec3 specular = spec * lightColor;

    vec4 color = vec4(ambient + shadow * (diff + specular) * diffuseColor, 1.0);
    //return DebugColorCascade(color, cascadeIndex);
    return color;
}

void PreparePCFCustom(mat4 modelMatrix, vec3 vertexPos, vec3 normal) {
    pcf_modelMatrix = modelMatrix;
    pcf_normal = mat3(modelMatrix) * normal;
    pcf_viewDir = VIEW_POSITION - vertexPos;
    pcf_viewPos = (VIEW_MATRIX * modelMatrix * vec4(normal, 1.0)).xyz;
}