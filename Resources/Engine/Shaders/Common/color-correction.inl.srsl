vec3 ACES(vec3 x) {
    float a = 2.51;
    float b = 0.03;
    float c = 2.43;
    float d = 0.59;
    float e = 0.14;
    return clamp(vec3((x * (a * x + b)) / (x * (c * x + d) + e)), vec3(0.0), vec3(1.0));
}

vec3 ACESFilm(vec3 x) {
    float a = 2.51;
    float b = 0.03;
    float c = 2.43;
    float d = 0.59;
    float e = 0.14;
    return clamp(vec3((x * (a * x + b)) / (x * (c * x + d) + e)), vec3(0.0), vec3(1.0));
}