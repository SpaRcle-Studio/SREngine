ShaderType PostProcessing;

PolygonMode Fill;
CullMode Back;
DepthCompare LessOrEqual;
PrimitiveTopology TriangleList;
BlendEnabled false;
DepthWrite false;
DepthTest false;

// Дистанция до ближайшей поверхности в блоке пикселей полного разрешения (1e6 - небо).
// Считается один раз в половинном разрешении, проходы пониженного разрешения читают ее через
// gbufferSceneDistance (Common/gbuffer.srsl) вместо G-buffer.

[[uniform]] sampler2D positionMap;
[[uniform]] sampler2D coverageMap;

[[shared]] vec2 uv;

#define USE_COLOR_INDEX_0

#include <Engine/Shaders/Common/gbuffer.srsl>

void fragment() {
    COLOR_INDEX_0 = vec4(gbufferLowResDistance(positionMap, coverageMap, uv, TARGET_RESOLUTION), 0.0, 0.0, 1.0);
}

void vertex() {
    uv = vec2(float((VERTEX_INDEX << 1) & 2), float(VERTEX_INDEX & 2));
    OUT_POSITION = vec4(uv * 2.0 - 1.0, 0.0, 1.0);
}
