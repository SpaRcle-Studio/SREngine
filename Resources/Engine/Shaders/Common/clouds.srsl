[[uniform]] sampler2D depthMap;
[[uniform]] sampler2D positionMap;

[[public], [uniform(SHARED)]] vec3 boundsMin;
[[public], [uniform(SHARED)]] vec3 boundsMax;
[[public], [uniform(SHARED)]] float cloudsSpeed = 1.0;
[[public], [uniform(SHARED)]] float cloudsFrequency = 2.0;
[[public], [uniform(SHARED)]] float cloudsAmplitude = 0.5;
[[public], [uniform(SHARED)]] float stepSize = 0.5;
[[public], [uniform(SHARED)]] int fbmOctaves = 5;

[[const], [uniform]] int seed = 42;

#include <Engine/Shaders/Common/noise.srsl>
#include <Engine/Shaders/Common/utils.srsl>

float hash31(vec3 p) {
    p = fract(p * 0.1031);
    p += dot(p, p.yzx + 33.33);
    return fract((p.x + p.y) * p.z);
}

float fbm(vec3 p) {
    float value = 0.0;
    float amplitude = 0.5;
    float frequency = 1.0;

    for (int i = 0; i < fbmOctaves; i++) {
        value += amplitude * perlinNoise(p * frequency);
        frequency *= cloudsFrequency;
        amplitude *= cloudsAmplitude;
    }
    return value;
}

vec3 applyClouds(vec3 color, vec2 inUV) {
    vec3 rayOrigin = VIEW_POSITION;
    vec3 rayDir = getRayDir(inUV);

    vec3 boundsMinV = boundsMin + vec3(VIEW_POSITION.x, 0.0, VIEW_POSITION.z);
    vec3 boundsMaxV = boundsMax + vec3(VIEW_POSITION.x, 0.0, VIEW_POSITION.z);

    vec3 info = intersectBox(rayOrigin, rayDir, boundsMinV, boundsMaxV);

    if (info.z > 0.6) { // если есть пересечение
        float depthValue = texture(depthMap, inUV).r;
        vec4 worldPos = texture(positionMap, inUV);

        float distToSurface = dot(worldPos.xyz - rayOrigin, rayDir);

        float tNear = max(info.x, 0.0);
        float tFar;

        if (depthValue > 0.0) {
            // расстояние до поверхности сцены вдоль луча
            tFar = min(info.y, distToSurface);
        }
        else {
            // глубины нет, значит ограничивать нечем
            tFar = info.y;
        }

        vec3 transmittance = vec3(1.0);
        vec3 cloudAccum = vec3(0.0);
        vec3 shadowColor = vec3(0.6, 0.65, 0.7);  // холодный серый-низ
        vec3 lightColor  = vec3(1.0, 0.95, 0.9);  // теплый верх

        for (float t = tNear; t < tFar; t += stepSize) {
            vec3 p = rayOrigin + rayDir * t;

            // шум = плотность облака
            float d = fbm(p * 0.025 + TIME * 0.000025 * cloudsSpeed);

            if (d > 0.0) {
                float density = smoothstep(0.45, 0.55, d); // 0..1 плавный
                density = pow(density, 1.5); // ослабить края

                vec3 local = (p - boundsMinV) / (boundsMaxV - boundsMinV);
                float edgeFade = smoothstep(0.0, 0.3, min(min(min(local.x, 1.0 - local.x), min(local.y, 1.0 - local.y)), min(local.z, 1.0 - local.z)));

                density *= edgeFade;

                // чем плотнее облако, тем ближе к светлому
                vec3 cloudColor = mix(shadowColor, lightColor, density);

                // можно добавить градиент по высоте (p.y нормализовать в 0..1 по высоте куба)
                float h = clamp((p.y - boundsMinV.y) / (boundsMaxV.y - boundsMinV.y), 0.0, 1.0);
                cloudColor = mix(cloudColor * 0.8, cloudColor * 1.2, h);

                vec3 scat = cloudColor * density;
                cloudAccum += transmittance * scat * stepSize;
                transmittance *= exp(-density * stepSize);

                if (transmittance.r < 0.01) {
                    break;
                }
            }
        }

        // композитинг: облака поверх сцены с учётом остаточной прозрачности
        return color * transmittance + cloudAccum;
    }
    return color;
}