// First reduction pass: HDR texture -> SSBO (log luminance sum per 16x16 workgroup).
// Each workgroup writes one float (sum of log(luminance)) to reductionOut.

ShaderType Compute;

[[uniform]] sampler2D hdrTexture;
[[uniform]] vec2 resolution;
[[ssbo(reductionOut)]] float[] reductionOut;
[[shared(workgroup)]] float[256] shSum;

[[THREADS(16, 16, 1)]]
void compute() {
    ivec2 localID = ivec2(gl_LocalInvocationID.xy);        // 0..15 в твоей 16x16 workgroup
    ivec2 workGroupID = ivec2(gl_WorkGroupID.xy);        // ID текущей группы
    ivec2 groupOffset = workGroupID * ivec2(16,16);      // смещение группы на экране
    ivec2 px = groupOffset + localID;                     // глобальные координаты пи
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);

    //ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    //if (px.x >= int(resolution.x) || px.y >= int(resolution.y)) {
    //    return;
    //}

    //vec2 uv = (vec2(px) + 0.5) / resolution;
    //vec2 uv = vec2(px) / resolution;
    vec2 uv = (vec2(gid) - 0.5) / (resolution);
    vec3 color = texture(hdrTexture, uv).rgb;
    float lum = max(dot(color, vec3(0.2126, 0.7152, 0.0722)), 1e-6);
    float logLum = log(lum);

    // Workgroup reduction in shared memory (16*16 = 256 threads)
    uint tid = gl_LocalInvocationIndex;

    //uint pixelsInGroupX = min(16, int(resolution.x) - px.x + localID.x);
    //uint pixelsInGroupY = min(16, int(resolution.y) - px.y + localID.y);
    //uint pixelsInGroup = pixelsInGroupX * pixelsInGroupY;

    shSum[tid] = logLum;// / float(pixelsInGroup);
    barrier();

    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (tid < s) {
            shSum[tid] += shSum[tid + s];
        }
        barrier();
    }

    if (tid == 0u) {
        uint groupId = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
        reductionOut[groupId] = shSum[0];
    }
}
