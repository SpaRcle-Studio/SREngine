// Temporal adaptation: luminance sum -> exposure SSBO.

ShaderType Compute;

[[uniform]] float keyValue;
[[uniform]] float speed;
[[uniform]] float dt;
[[uniform]] float totalPixelCount;

[[ssbo(luminanceIn)]] float[] luminanceIn;
[[ssbo(exposureOut)]] float[] exposureOut;

[[THREADS(1, 1, 1)]]
void compute() {
    float prevExposure = exposureOut[1];
    float luminanceSum = luminanceIn[0];
    float avgLogLum = luminanceSum / max(totalPixelCount, 1.0);
    float avgLum = exp(avgLogLum);
    float target = (keyValue) / max(avgLum, 1e-6);
    target = clamp(target, 0.01, 3.0);

    float adapted = prevExposure + (target - prevExposure) * (1.0 - exp(-dt * speed));

    exposureOut[0] = adapted;
    exposureOut[1] = adapted;
}
