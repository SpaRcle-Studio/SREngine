ShaderType Canvas;

#ifdef DISABLE_CULLING
    CullMode None;
#else
    CullMode Back;
#endif

PolygonMode Fill;
DepthCompare LessOrEqual;
PrimitiveTopology TriangleList;
BlendEnabled true;
DepthWrite false;
DepthTest true;

[[shared]] vec2 UV;
[[shared]] vec4 glyphColor;
[[shared]] vec4 glyphMetadata;
[[shared]] float glyphSdfRange;

[[uniform]] float textVisible;
[[uniform]] vec4 textEffect;

[[uniform], [public]] vec3 color = vec3(1.0, 1.0, 1.0);
[[uniform], [public]] sampler2D diffuse;

float median(float r, float g, float b) {
    return max(min(r, g), min(max(r, g), b));
}

void fragment() {
    if (glyphMetadata.x >= textVisible) {
        discard;
    }
    if (glyphMetadata.w == 1.0) {
        COLOR = vec4(color * glyphColor.rgb, glyphColor.a);
    }
    else {
        vec4 tex = texture(diffuse, UV);
        float msd = glyphMetadata.w == 2.0 || glyphMetadata.w == 4.0 ? tex.r : median(tex.r, tex.g, tex.b);
        float w = max(fwidth(msd), 1.0 / 1024.0);
        if (glyphMetadata.w == 0.0) {
            // Differentiate UVs: MSDF channel transitions must not widen the antialiasing band.
            vec2 unitRange = vec2(glyphSdfRange) / vec2(textureSize(diffuse, 0));
            vec2 screenTexSize = vec2(1.0) / max(fwidth(UV), vec2(0.000001));
            float screenRange = max(0.5 * dot(unitRange, screenTexSize), 1.0);
            w = 0.5 / screenRange;
        }
        float threshold = 0.5 - glyphMetadata.y * 0.055;
        float alpha = glyphMetadata.w == 4.0 ? tex.r : smoothstep(threshold - w, threshold + w, msd);
        if (glyphMetadata.w == 3.0) {
            COLOR = tex * glyphColor * vec4(color, 1.0);
        }
        else {
            COLOR = vec4(color * glyphColor.rgb, alpha * glyphColor.a);
        }
    }

#ifdef SR_DEFINE_WIREFRAME
    COLOR = vec4(1.0, 0.0, 0.0, 1.0);
#endif
}

void vertex() {
    vec2 sprite_vertices[6] = {
        vec2(0, 0),
        vec2(1, 1),
        vec2(1, 0),
        vec2(0, 0),
        vec2(0, 1),
        vec2(1, 1)
    };

    UV = mix(UV1, UV2, sprite_vertices[VERTEX_INDEX]);
    vec2 pos = NDC_RECT.xy + POSITION0 + sprite_vertices[VERTEX_INDEX] * (POSITION1 - POSITION0);
    glyphColor = COLOR0;
    glyphMetadata = CUSTOM0;
    glyphSdfRange = CUSTOM1.y;
    if (CUSTOM0.w != 1.0) {
        pos.x += CUSTOM0.z * (sprite_vertices[VERTEX_INDEX].y - 0.5) * (POSITION1.y - POSITION0.y) * 0.2;
        float index = CUSTOM1.x;
        pos.y += sin(textEffect.x * textEffect.w + index * 0.7) * textEffect.y;
        float tick = floor(textEffect.x * max(1.0, textEffect.w));
        pos += vec2(sin(index * 12.9898 + tick * 78.233), cos(index * 39.346 + tick * 11.135)) * textEffect.z;
    }
    OUT_POSITION = PIXEL_ORTHOGONAL_MATRIX * MODEL_MATRIX * vec4(pos, 0.0, 1.0);
}
