ShaderType Canvas;

PolygonMode Fill;
CullMode Back;
DepthCompare LessOrEqual;
PrimitiveTopology TriangleStrip;
BlendEnabled true;
DepthWrite true;
DepthTest true;

[[shared]] vec2 UV;

[[uniform], [public]] vec3 color = vec3(1.0, 1.0, 1.0);

void fragment() {
    COLOR = texture(TEXT_ATLAS_TEXTURE, UV) + vec4(color, 0.0);

    if (COLOR.a == 0) {
        discard;
    }
}

void vertex() {
    #include <Engine/Shaders/UI/sprite-vertices.inl.srsl>

    vec2 size = TEXT_ATLAS_SIZE;

    vec2 sprite_vertices[4] = {
        NDC_RECT.xy + vec2(0.0, 0.0) * size, // левый-нижний
        NDC_RECT.xy + vec2(0.0, 1.0) * size, // левый-верхний
        NDC_RECT.xy + vec2(1.0, 0.0) * size, // правый-нижний
        NDC_RECT.xy + vec2(1.0, 1.0) * size  // правый-верхний
    };

    OUT_POSITION = PIXEL_ORTHOGONAL_MATRIX * vec4(sprite_vertices[VERTEX_INDEX] * UI_SCALE, 0.0, 1.0);
    UV = uv[VERTEX_INDEX];
}