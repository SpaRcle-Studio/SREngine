ShaderType Line;

PolygonMode Line;
CullMode None;
DepthCompare LessOrEqual;
PrimitiveTopology LineList;
BlendEnabled false;
DepthWrite true;
DepthTest true;

[[shared]] vec3 position;

void fragment() {
    COLOR = LINE_COLOR;
    COLOR_INDEX_1 = vec4(gl_FragCoord.z);
    COLOR_INDEX_2 = vec4(position, 1.0);
}

void vertex() {
    position = float(VERTEX_INDEX == 0) * LINE_START_POINT + float(VERTEX_INDEX == 1) * LINE_END_POINT;
    OUT_POSITION = PROJECTION_MATRIX * VIEW_MATRIX * vec4(position, 1.0);
}