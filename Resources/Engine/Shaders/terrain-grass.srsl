/// Процедурная трава террейна (TerrainGrass / TerrainGrassRenderer).
/// Геометрии нет: травинка строится по VERTEX_INDEX как два triangle strip'а (левая и правая половина
/// от центральной жилки), склеенные вырожденными треугольниками: 2 * (2 * segments + 1) + 2 вершин.
/// Инстанс: CUSTOM0 = (корень относительно grassOrigin, rank), CUSTOM1 = (нормаль террейна, random).

ShaderType Spatial;

PolygonMode Fill;
CullMode None;
DepthCompare LessOrEqual;
PrimitiveTopology TriangleStrip;
DepthWrite true;
DepthTest true;
BlendEnabled false;

#define SR_NO_PCF_FILTER

#ifdef SR_DEFINE_USE_CASCADED_SHADOW_MAP
    #include <Engine/Shaders/Common/pcf-utils.inl.srsl>
#endif

/// ------------------------------------------ параметры, выставляемые из кода ------------------------------------------

[[uniform]] vec3 grassOrigin;
[[uniform]] float grassFullDensityDistance = 12.0;
[[uniform]] float grassMaxDistance = 80.0;
[[uniform]] float grassFalloff = 1.6;
[[uniform]] float grassMinKeep = 0.04;
[[uniform]] float grassSegmentsLodDistance = 25.0;
[[uniform]] int grassSegments = 5;
[[uniform]] int grassLowSegments = 2;

/// Точки, приминающие траву (TerrainGrassBender и точки их следов). Раскладка - TerrainGrassBenderGPU.
/// vec4 вместо vec3 + float: так раскладка std430 гарантированно совпадает с C++ (32 байта на точку)
struct GrassBender {
    vec4 positionRadius;
    vec4 directionStrength;
};

[[ssbo(grassBenders)]] GrassBender[] grassBenders;
/// Совпадает с SR_TERRAIN_GRASS_MAX_BENDERS
[[const]] int GRASS_MAX_BENDERS = 256;
[[uniform]] int grassBendersCount = 0;

/// ------------------------------------------ параметры материала ------------------------------------------

/// форма
[[uniform], [public]] float bladeHeightMin = 0.3;
[[uniform], [public]] float bladeHeightMax = 0.8;
[[uniform], [public]] float bladeWidthMin = 0.02;
[[uniform], [public]] float bladeWidthMax = 0.045;
[[uniform], [public]] float bladeBend = 0.3;
[[uniform], [public]] float bladeFold = 0.45;
[[uniform], [public]] float normalInfluence = 0.35;
[[uniform], [public]] float viewAlign = 0.45;
[[uniform], [public]] float farWidthBoost = 1.6;
[[uniform], [public]] float farNormalFlatten = 0.75;

/// кланпы (группы травинок с общей высотой/оттенком)
[[uniform], [public]] float clumpSize = 1.1;
[[uniform], [public]] float clumpHeightVariation = 0.4;

/// разнообразие
[[uniform], [public]] float shortGrassChance = 0.08;
[[uniform], [public]] float wideGrassChance = 0.05;
[[uniform], [public]] float tallGrassChance = 0.07;
[[uniform], [public]] float dryBladeChance = 0.06;
[[uniform], [public]] float dryTipChance = 0.3;

/// цвет (линейное пространство, значения близки к реальному альбедо травы)
[[uniform], [public]] vec3 rootColor = vec3(0.016, 0.022, 0.007);
[[uniform], [public]] vec3 baseColor = vec3(0.045, 0.075, 0.016);
[[uniform], [public]] vec3 baseColorWarm = vec3(0.08, 0.09, 0.022);
[[uniform], [public]] vec3 tipColor = vec3(0.14, 0.16, 0.055);
[[uniform], [public]] vec3 dryColor = vec3(0.34, 0.27, 0.13);
[[uniform], [public]] vec3 dryColorDark = vec3(0.16, 0.12, 0.06);
[[uniform], [public]] float hueVariation = 0.7;
[[uniform], [public]] float brightnessVariation = 0.12;
[[uniform], [public]] float dryAmount = 0.35;
[[uniform], [public]] float dryNoiseScale = 0.02;
[[uniform], [public]] float colorNoiseScale = 0.08;

/// освещение
[[uniform], [public]] float rootAO = 0.2;
[[uniform], [public]] float translucency = 0.55;
[[uniform], [public]] vec3 translucencyTint = vec3(1.25, 1.45, 0.6);
[[uniform], [public]] float specularIntensity = 0.6;
[[uniform], [public]] float specularPower = 18.0;
[[uniform], [public]] float wrapLighting = 0.35;

/// ветер. TIME приходит в миллисекундах, отсюда timeScale.
[[uniform], [public]] vec2 windDirection = vec2(1.0, 0.35);
[[uniform], [public]] float windStrength = 0.3;
[[uniform], [public]] float windScale = 0.03;
[[uniform], [public]] float windSpeed = 4.0;
[[uniform], [public]] float windSwayStrength = 0.12;
[[uniform], [public]] float windSwaySpeed = 1.8;
[[uniform], [public]] float windWaveFrequency = 0.35;
[[uniform], [public]] float windFlutterStrength = 0.035;
[[uniform], [public]] float windFlutterSpeed = 9.0;
[[uniform], [public]] float windSheen = 0.35;
[[uniform], [public]] float timeScale = 0.001;

/// приминание
[[uniform], [public]] float bendFlatten = 0.55;

/// VERTEX/NORMAL во фрагментный этап без вершинных атрибутов не передаются, поэтому свои varyings
[[shared]] vec3 grassAlbedo;
[[shared]] vec3 grassWorldPos;
[[shared]] vec3 grassNormal;
[[shared]] float grassT;
[[shared]] float grassWind;
[[shared]] float grassDry;

/// ------------------------------------------ утилиты ------------------------------------------

float grassHash21(vec2 p) {
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
}

float grassHash11(float p) {
    p = fract(p * 0.1031);
    p *= p + 33.33;
    p *= p + p;
    return fract(p);
}

/// value noise [0, 1]
float grassNoise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);

    float a = grassHash21(i);
    float b = grassHash21(i + vec2(1.0, 0.0));
    float c = grassHash21(i + vec2(0.0, 1.0));
    float d = grassHash21(i + vec2(1.0, 1.0));

    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

float grassFbm2(vec2 p) {
    return grassNoise(p) * 0.65 + grassNoise(p * 2.13 + vec2(17.1, 3.7)) * 0.35;
}

float grassKeepFraction(float distance) {
    if (distance <= grassFullDensityDistance) {
        return 1.0;
    }
    if (distance >= grassMaxDistance) {
        return 0.0;
    }
    float x = 1.0 - (distance - grassFullDensityDistance) / max(grassMaxDistance - grassFullDensityDistance, 0.001);
    return max(grassMinKeep, pow(x, grassFalloff));
}

/// Смещение верхушки от одной приминающей точки (в долях высоты травинки)
vec3 grassBendPush(GrassBender bender, vec3 root, float height, vec3 fallback) {
    float radius = bender.positionRadius.w;
    float strength = bender.directionStrength.w;
    if (radius <= 0.0 || strength <= 0.0) {
        return vec3(0.0);
    }

    vec3 delta = root - bender.positionRadius.xyz;
    float above = -delta.y;
    delta.y = 0.0;

    float distSq = dot(delta, delta);
    if (distSq >= radius * radius) {
        return vec3(0.0);
    }
    float dist = sqrt(distSq);

    /// объект должен касаться травинки по высоте
    float vertical = smoothstep(-radius - 0.3, -radius, above) * (1.0 - smoothstep(height, height + radius, above - radius * 0.5));
    float influence = (1.0 - smoothstep(radius * 0.25, radius, dist)) * vertical * strength;

    /// в центре следа трава ложится по ходу движения, к краям - расходится в стороны
    vec3 dir = fallback;
    vec3 moveDir = bender.directionStrength.xyz;
    if (dot(moveDir, moveDir) > 0.25) {
        dir = moveDir;
    }
    if (dist > 0.001) {
        dir = normalize(mix(dir, delta / dist, smoothstep(0.0, radius * 0.7, dist)) + vec3(0.00001));
    }

    return dir * influence;
}

/// ------------------------------------------ вершинный шейдер ------------------------------------------

void vertex() {
    vec3 root = CUSTOM0.xyz + grassOrigin;
    float rank = CUSTOM0.w;
    float rnd = CUSTOM1.w;
    vec3 terrainNormal = CUSTOM1.xyz;

    float r0 = grassHash11(rnd * 1000.0 + 1.0);
    float r1 = grassHash11(rnd * 1000.0 + 2.0);
    float r2 = grassHash11(rnd * 1000.0 + 3.0);
    float r3 = grassHash11(rnd * 1000.0 + 4.0);
    float r4 = grassHash11(rnd * 1000.0 + 5.0);
    float r5 = grassHash11(rnd * 1000.0 + 6.0);
    float r6 = grassHash11(rnd * 1000.0 + 7.0);

    vec3 toCamera = VIEW_POSITION - root;
    float distance = length(toCamera);

    /// ---- плавное прореживание по дистанции (CPU отсекает целые корзины, здесь гасим отдельные травинки)
    float keep = grassKeepFraction(distance);
    float fade = clamp((keep - rank) / 0.06, 0.0, 1.0);

    /// ---- кланпы: соседние травинки получают общую высоту и оттенок
    vec2 clumpCell = floor(root.xz / max(clumpSize, 0.01));
    float clumpA = grassHash21(clumpCell);
    float clumpB = grassHash21(clumpCell + vec2(17.31, 5.17));

    /// ---- сухость: пятна по шуму + отдельные сухие травинки
    float dryNoise = grassNoise(root.xz * dryNoiseScale + vec2(31.7, 11.3));
    float dry = smoothstep(0.5, 0.85, dryNoise) * dryAmount;
    dry = clamp(dry + (clumpB - 0.5) * 0.3 * dryAmount, 0.0, 1.0);
    float dryBlade = 0.0;
    if (r5 < dryBladeChance) {
        dryBlade = 1.0;
    }
    dry = max(dry, dryBlade);

    /// ---- форма: типы травинок
    float height = mix(bladeHeightMin, bladeHeightMax, pow(r0, 1.3));
    height *= 1.0 + (clumpA - 0.5) * 2.0 * clumpHeightVariation;
    float width = mix(bladeWidthMin, bladeWidthMax, r1);
    float bendAmount = bladeBend * mix(0.3, 1.0, r3);
    float stiffness = 1.0;

    if (r4 < shortGrassChance) {
        /// низкий подшёрсток
        height *= mix(0.25, 0.45, r0);
        width *= 0.75;
        bendAmount *= 1.4;
        stiffness = 0.6;
    }
    else if (r4 < shortGrassChance + wideGrassChance) {
        /// короткая широкая травинка
        height *= 0.6;
        width *= 1.7;
        bendAmount *= 1.3;
    }
    else if (r4 > 1.0 - tallGrassChance) {
        /// высокая тонкая травинка
        height *= 1.45;
        width *= 0.7;
        stiffness = 1.3;
    }

    /// сухие травинки жёстче, но сильнее полегают
    bendAmount *= mix(1.0, 1.7, dryBlade);
    stiffness *= mix(1.0, 0.7, dryBlade);

    /// вдали травинок меньше, поэтому оставшиеся делаются шире, чтобы поле не "лысело"
    width *= mix(1.0, farWidthBoost, 1.0 - keep);

    height *= fade;
    width *= fade;

    /// ---- базис травинки
    vec3 up = normalize(mix(vec3(0.0, 1.0, 0.0), normalize(terrainNormal), normalInfluence));

    float angle = r2 * 6.2831853;
    vec3 forward = vec3(cos(angle), 0.0, sin(angle));

    /// разворачиваем травинку к камере, когда она видна ребром - иначе поле "мерцает" и выглядит редким
    vec3 viewH = toCamera - up * dot(toCamera, up);
    float viewHLen = length(viewH);
    if (viewHLen > 0.0001) {
        viewH /= viewHLen;
        float facing = dot(forward, viewH);
        /// тернарный оператор со сравнением SRSL разбирает неправильно, поэтому через if
        vec3 target = viewH;
        if (facing < 0.0) {
            target = -viewH;
        }
        /// вблизи не разворачиваем: направление на камеру там быстро меняется и травинки "крутятся" при движении
        float alignFade = smoothstep(4.0, 12.0, distance);
        forward = normalize(mix(forward, target, viewAlign * alignFade * (1.0 - abs(facing))));
    }

    vec3 side = normalize(cross(up, forward));
    forward = normalize(cross(side, up));

    /// ---- ветер
    /// Крупное поле порывов бежит по траве вдоль направления ветра (волны), травинки раскачиваются
    /// вокруг наклона с фазой, зависящей от позиции (волна переходит от травинки к травинке),
    /// и мелко дрожат поперёк ветра. Сила раскачки растёт в порывах.
    vec2 windDir2 = normalize(windDirection);
    vec3 windDir = vec3(windDir2.x, 0.0, windDir2.y);
    windDir = normalize(windDir - up * dot(windDir, up) + vec3(0.00001));
    vec3 windSide = normalize(cross(up, windDir));

    float time = TIME * timeScale;
    vec2 windUV = root.xz * windScale - windDir2 * (time * windSpeed * windScale);
    float gust = smoothstep(0.3, 0.8, grassFbm2(windUV));

    float lean = windStrength * (0.2 + 0.8 * gust);
    float swayPhase = dot(root.xz, windDir2) * windWaveFrequency - time * windSwaySpeed + rnd * 1.7;
    float sway = sin(swayPhase) * windSwayStrength * (0.35 + gust);
    float flutter = sin(time * windFlutterSpeed + rnd * 6.2831853 + root.x * 1.7 + root.z * 1.3) * windFlutterStrength * (0.3 + gust);

    /// высокие травинки гнутся сильнее, короткие жёстче
    float flex = clamp(height / max(bladeHeightMax, 0.01), 0.3, 1.3) / stiffness;
    vec3 windOffset = (windDir * (lean + sway) + windSide * flutter) * flex;

    /// ---- приминание
    vec3 bendPush = vec3(0.0);
    /// Количество приходит из UBO. Если он не заполнен (сразу после пересоздания ресурсов при ресайзе), там может
    /// оказаться мусор, а выход за размер SSBO или бесконечный цикл роняют устройство - поэтому жёсткий предел.
    int bendersCount = clamp(grassBendersCount, 0, GRASS_MAX_BENDERS);
    for (int i = 0; i < bendersCount; ++i) {
        bendPush += grassBendPush(grassBenders[i], root, height, forward);
    }
    float pressed = min(length(bendPush), 1.0);
    vec3 pushDir = forward;
    if (pressed > 0.001) {
        pushDir = normalize(bendPush - up * dot(bendPush, up) + vec3(0.00001));
    }

    /// примятая трава почти не качается
    windOffset *= 1.0 - pressed * 0.85;

    /// смещение верхушки относительно прямого стебля (в долях высоты)
    vec3 tipOffset = forward * bendAmount + windOffset + pushDir * (pressed * 1.3);
    float tipOffsetLen = min(length(tipOffset), 1.4);

    /// ---- вершина
    /// Число сегментов определяет CPU для всей ячейки (оно зашито в количество вершин draw call'а).
    int segments = grassSegments;
    if (grassSegmentsLodDistance > 0.0 && distance >= grassSegmentsLodDistance) {
        segments = grassLowSegments;
    }

    /// половина травинки: strip из пар (край, жилка) + верхушка; половины склеены двумя вырожденными вершинами
    int halfCount = segments * 2 + 1;
    int vertexIndex = min(VERTEX_INDEX, halfCount * 2 + 1);

    int halfIndex = 0;
    int local = vertexIndex;
    if (vertexIndex == halfCount) {
        local = halfCount - 1;
    }
    if (vertexIndex == halfCount + 1) {
        halfIndex = 1;
        local = 0;
    }
    if (vertexIndex > halfCount + 1) {
        halfIndex = 1;
        local = vertexIndex - halfCount - 2;
    }

    float halfSign = -1.0;
    if (halfIndex == 1) {
        halfSign = 1.0;
    }

    float t = float(local / 2) / float(segments);
    float edge = 0.0; /// -1 левый край, 0 жилка, 1 правый край
    if (local == halfCount - 1) {
        t = 1.0;
    }
    else {
        int isFirst = 0;
        if (local % 2 == 0) {
            isFirst = 1;
        }
        if (halfIndex == 0 && isFirst == 1) {
            edge = -1.0;
        }
        if (halfIndex == 1 && isFirst == 0) {
            edge = 1.0;
        }
    }

    float taper = width * pow(1.0 - t, 0.75);

    /// сгиб по жилке: края травинки отогнуты вперёд относительно жилки (V-профиль), вдали сгиб убирается
    float fold = bladeFold * mix(1.0, 0.4, t) * (1.0 - smoothstep(20.0, 40.0, distance));

    /// изгиб по параболе t^2 - корень неподвижен, верхушка смещается сильнее всего;
    /// стебель укорачивается по вертикали, чтобы сохранять примерно постоянную длину
    vec3 bend = tipOffset * (t * t) * height;
    float shrink = (1.0 - 0.35 * tipOffsetLen * tipOffsetLen * t) * (1.0 - bendFlatten * pressed * t);

    vec3 position = root + up * (height * t * shrink) + bend
        + side * (edge * taper)
        + forward * (abs(edge) * fold * taper);

    /// нормаль половины травинки: перпендикуляр к касательной стебля, развёрнутый по сгибу
    vec3 tangent = normalize(up * height * shrink + tipOffset * (2.0 * t * height) + vec3(0.0, 0.00001, 0.0));
    vec3 baseNormal = normalize(cross(side, tangent));
    vec3 normal = normalize(baseNormal - side * (halfSign * (fold + 0.25)));

    /// вдали нормали сводятся к нормали поверхности - поле освещается как сплошной массив, без шума
    normal = normalize(mix(normal, up, smoothstep(15.0, 50.0, distance) * farNormalFlatten));

    if (fade <= 0.0) {
        /// все вершины в одну точку - вырожденные треугольники растеризатор отбросит
        position = root;
    }

    VERTEX = position;
    grassWorldPos = position;
    grassNormal = normal;
    grassT = t;
    grassWind = gust * (1.0 - pressed);

    /// ---- цвет
    float colorNoise = grassNoise(root.xz * colorNoiseScale + vec2(5.3, 71.9));
    float hue = clamp(r1 * 0.45 + clumpB * 0.35 + (colorNoise - 0.5) * 0.8 + 0.1, 0.0, 1.0) * hueVariation;
    vec3 fresh = mix(baseColor, baseColorWarm, hue);

    vec3 color = mix(rootColor, fresh, smoothstep(0.0, 0.3, t));
    color = mix(color, mix(fresh, tipColor, 0.6 + 0.4 * r6), smoothstep(0.35, 1.0, t));

    /// подсохшие кончики у части травинок
    float dryTip = 0.0;
    if (r6 < dryTipChance) {
        dryTip = smoothstep(0.65, 1.0, t) * mix(0.4, 0.9, r3);
    }

    vec3 dryTone = mix(dryColorDark, dryColor, mix(0.35, 1.0, t) * mix(0.7, 1.0, r0));
    color = mix(color, dryTone, max(dry, dryTip));
    color *= 1.0 + (r1 - 0.5) * 2.0 * brightnessVariation;

    grassAlbedo = color;
    grassDry = max(dry, dryTip);

#ifdef SR_DEFINE_CASCADED_SHADOW_MAP_PASS
    #include <Engine/Shaders/Common/apply-cascades-transform.inl.srsl>
#else
    #ifdef SR_DEFINE_USE_CASCADED_SHADOW_MAP
        PreparePCF();
    #endif
    OUT_POSITION = PROJECTION_MATRIX * VIEW_MATRIX * vec4(VERTEX, 1.0);
#endif
}

/// ------------------------------------------ фрагментный шейдер ------------------------------------------

void fragment() {
#ifdef SR_DEFINE_CASCADED_SHADOW_MAP_PASS
    COLOR = vec4(1.0);
#else
    vec3 V = normalize(VIEW_POSITION - grassWorldPos);
    vec3 N = normalize(grassNormal);

    /// травинка двусторонняя: освещаем сторону, обращённую к камере
    if (dot(N, V) < 0.0) {
        N = -N;
    }

    vec3 L = normalize(-DIRECTIONAL_LIGHT_DIRECTION);
    vec3 H = normalize(L + V);

    float shadowFactor = 1.0;

#ifdef SR_DEFINE_USE_CASCADED_SHADOW_MAP
    uint cascadeIndex = SelectCascade(grassWorldPos);
    if (cascadeIndex < NUM_CASCADES) {
        vec4 shadowCoord = biasMat * CASCADE_LIGHT_SPACE_MATRICES[cascadeIndex] * vec4(grassWorldPos, 1.0);
        float shadow = filterPCF(N, shadowCoord, cascadeIndex);
        shadowFactor = mix(1.0 - SHADOW_STRENGTH, 1.0, shadow);
    }
#endif

    /// в порывах травинки наклоняются и показывают более светлую, матовую сторону
    vec3 albedo = grassAlbedo;
    albedo = mix(albedo, albedo * 1.35 + vec3(0.006, 0.006, 0.003), grassWind * windSheen * grassT);

    float ao = mix(rootAO, 1.0, smoothstep(0.0, 0.7, grassT));

    vec3 sun = SUN_COLOR * SUN_INTENSITY;

    /// wrap-диффуз: трава тонкая, свет "заходит" за терминатор
    float ndotlRaw = dot(N, L);
    float ndotl = clamp((ndotlRaw + wrapLighting) / (1.0 + wrapLighting), 0.0, 1.0);

    /// просвечивание: свет, прошедший сквозь лист, насыщеннее и желтее; у сухой травы почти нет
    float backLit = pow(clamp(dot(V, -L), 0.0, 1.0), 3.0) * translucency * mix(0.3, 1.0, grassT) * (1.0 - grassDry * 0.8);
    vec3 transmitted = albedo * translucencyTint * backLit;

    /// нормированный Блинн-Фонг с Френелем: блеск травы заметен в основном под скользящим углом
    float ndoth = max(dot(N, H), 0.0);
    float ndotv = max(dot(N, V), 0.0);
    float fresnel = 0.04 + 0.96 * pow(1.0 - ndotv, 5.0);
    float specNorm = (specularPower + 8.0) / 25.1327;
    float spec = pow(ndoth, specularPower) * specNorm * fresnel * specularIntensity * max(ndotlRaw, 0.0) * mix(1.0, 0.4, grassDry) * grassT;

    float upFactor = clamp(N.y * 0.5 + 0.5, 0.0, 1.0);
    vec3 ambient = mix(GROUND_COLOR, SKY_COLOR, upFactor) * AMBIENT_INTENSITY * ao;

    vec3 lighting =
          albedo * ambient
        + shadowFactor * sun * (albedo * ndotl * ao + transmitted + vec3(spec));

    COLOR = vec4(lighting, 1.0);
#endif

    COLOR_INDEX_1 = vec4(gl_FragCoord.z);
    COLOR_INDEX_2 = vec4(grassWorldPos, 1.0);
    COLOR_INDEX_3 = vec4(grassNormal, 1.0);
}
