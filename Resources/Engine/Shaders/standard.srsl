#ifdef HAS_SKELETON
    ShaderType Skinned;
#else
    ShaderType Spatial;
#endif

PolygonMode Fill;

#ifdef SR_DEFINE_CASCADED_SHADOW_MAP_PASS
    CullMode None;
#else
    #ifdef DISABLE_CULLING
        CullMode None;
    #else
        CullMode Back;
    #endif
#endif

DepthCompare LessOrEqual;
PrimitiveTopology TriangleList;

DepthWrite true;

#ifdef HAS_ALPHA
    #ifndef SR_DEFINE_CASCADED_SHADOW_MAP_PASS
        #ifndef DISABLE_BLENDING
            BlendEnabled true;
        #endif
    #endif
#endif

DepthTest true;

[[uniform], [public]] vec4 color = vec4(1.0, 1.0, 1.0, 1.0);
[[uniform], [public]] float alphaThreshold = 0.0;

[[uniform], [public]] sampler2D diffuse;
[[uniform], [public]] sampler2D normal;
[[uniform], [public]] sampler2D alphaMask;

#ifdef HAS_SKELETON
    [[ssbo(bones)]] mat4[] bones;
    [[ssbo(offsets)]] mat4[] boneOffsets;
#endif

[[uniform], [public]] float specularSharpness = 1.0;
[[uniform], [public]] float specularIntensity = 1.0;
[[uniform], [public]] float ambientIntensity = 1.0;
[[uniform], [public]] float shadowIntensity = 1.0;
[[uniform], [public]] float diffuseMin = 0.0; // 0.0 = классический Ламберт, >0 = подсветка обратной стороны
[[uniform], [public]] vec2 tiling = vec2(1.0, 1.0);
[[uniform], [public]] vec2 offset = vec2(0.0, 0.0);

#ifdef SR_DEFINE_USE_CASCADED_SHADOW_MAP
    #include <Engine/Shaders/Common/pcf-utils.inl.srsl>
#endif

void fragment() {
    COLOR_INDEX_1 = vec4(gl_FragCoord.z);
    COLOR_INDEX_2 = vec4(VERTEX, 1.0);

    vec2 tiledUV = UV * tiling + offset;
    vec4 diffuseColorBase = texture(diffuse, tiledUV);
    vec4 diffuseColor = diffuseColorBase * color;

#ifdef HAS_ALPHA
    #ifdef HAS_ALPHA_MASK
        float maskAlpha = texture(alphaMask, tiledUV).r;
        diffuseColor.a *= maskAlpha;
    #endif

    if (diffuseColor.a < alphaThreshold) {
        discard;
    }
    float alpha = diffuseColor.a;
#else
    float alpha = 1.0;
#endif

    float maybe_unused_specularSharpness = specularSharpness;
    float maybe_unused_specularIntensity = specularIntensity;
    float maybe_unused_ambientIntensity = ambientIntensity;
    float maybe_unused_shadowIntensity = shadowIntensity;
    float maybe_unused_diffuseMin = diffuseMin;

#ifdef SR_DEFINE_USE_CASCADED_SHADOW_MAP
    vec3 lightColor = vec3(1.0);
    vec3 shadowColor = CalculateShadow(diffuseColor.rgb, lightColor,
        maybe_unused_specularSharpness,
        maybe_unused_specularIntensity,
        maybe_unused_ambientIntensity,
        maybe_unused_shadowIntensity,
        maybe_unused_diffuseMin
    ).rgb;
    COLOR = vec4(shadowColor, alpha);
#else
    #ifdef HAS_NORMAL
        vec3 normalMap = texture(normal, UV).xyz * 2.0 - 1.0;
        mat3 TBN = mat3(normalize(TANGENT), normalize(BITANGENT), normalize(NORMAL));
        vec3 mappedNormal = normalize(TBN * normalMap);

        float light = dot(mappedNormal, normalize(vec3(0.5, 0.5, 1.0))); // условный свет сверху
        light = clamp(light, 0.0, 1.0);
        vec3 normalShade = diffuseColor.rgb * (0.2 + 0.8 * light);
        COLOR = vec4(normalShade, alpha);
    #else
        vec3 normalShade = vec3(NORMAL.x + NORMAL.y + NORMAL.z) / 8.0;
        COLOR = vec4(diffuseColor.rgb + normalShade, alpha);
    #endif
#endif

#ifdef SR_DEFINE_DEBUG_NORMALS
    COLOR = vec4(NORMAL, 1.0);
#endif
}

void vertex() {
#ifdef HAS_SKELETON
    #include <Engine/Shaders/Common/bone-transform.inl.srsl>
    mat4 modelMatrix = boneTransform;
#else
    mat4 modelMatrix = MODEL_MATRIX;
#endif

    VERTEX = (modelMatrix * vec4(VERTEX, 1.0)).xyz;

#ifdef SR_DEFINE_CASCADED_SHADOW_MAP_PASS
    #include <Engine/Shaders/Common/apply-cascades-transform.inl.srsl>
#else
    #ifdef SR_DEFINE_USE_CASCADED_SHADOW_MAP
        PreparePCF(modelMatrix);
    #endif

    OUT_POSITION = PROJECTION_MATRIX * VIEW_MATRIX * vec4(VERTEX, 1.0);
#endif
}