ShaderType Spatial;

PolygonMode Fill;
CullMode Back;
DepthCompare LessOrEqual;
PrimitiveTopology TriangleList;
BlendEnabled false; 
DepthWrite true;
DepthTest true;

[[uniform], [public]] vec4 color;
[[uniform], [public]] sampler2D diffuse;

#ifdef SR_DEFINE_USE_CASCADED_SHADOW_MAP
    #include <Engine/Shaders/CascadedShadowMap/pcf-utils.inl.srsl>
#endif

void fragment() {
    vec3 diffuseColor = texture(diffuse, UV).rgb * color.rgb;

#ifdef SR_DEFINE_USE_CASCADED_SHADOW_MAP
    vec3 lightColor = vec3(1.0);
    COLOR = CalculateShadow(diffuseColor, lightColor);
#else
    vec3 normalShade = vec3(NORMAL.x + NORMAL.y + NORMAL.z) / 8.0;
	COLOR = vec4(diffuseColor + normalShade, 1.0);
#endif
}

void vertex() {
#ifdef SR_DEFINE_CASCADED_SHADOW_MAP_PASS
    OUT_POSITION = CASCADE_LIGHT_SPACE_MATRICES[PC_SHADOW_CASCADE_INDEX] * MODEL_MATRIX * vec4(VERTEX, 1.0);
#else
    #ifdef SR_DEFINE_USE_CASCADED_SHADOW_MAP
        PreparePCF(MODEL_MATRIX);
    #endif
    OUT_POSITION = PROJECTION_MATRIX * VIEW_MATRIX * MODEL_MATRIX * vec4(VERTEX, 1.0);
#endif
}