#include <Engine/Shaders/Common/standard-header.srsl>
#include <Engine/Shaders/Common/standard-vertex.srsl>

[[uniform], [public]] vec4 color = vec4(1.0, 1.0, 1.0, 1.0);
[[uniform], [public]] float alphaThreshold = 0.0;

[[uniform], [public]] sampler2D diffuse;
[[uniform], [public]] sampler2D normal;
[[uniform], [public]] sampler2D roughnessMap;
[[uniform], [public]] sampler2D detailWeight;
[[uniform], [public]] sampler2D sss;
[[uniform], [public]] sampler2D emission;
[[uniform], [public]] sampler2D alphaMask;
[[uniform], [public]] sampler2D ORM;

// Модель metallic-roughness (glTF 2.0). Скаляры - множители соответствующих текстур,
// без текстуры работают как значения: metallic 0..1, roughness 0..1 (0 - зеркало).
[[uniform], [public]] float metallic = 0.0;
[[uniform], [public]] float roughness = 1.0;
// отражательная способность диэлектрика: 0.5 = F0 0.04 (большинство материалов), 0 - без бликов
[[uniform], [public]] float specular = 0.5;
[[uniform], [public]] float occlusionStrength = 1.0;
[[uniform], [public]] float normalStrength = 1.0;
[[uniform], [public]] float shadowIntensity = 1.0;
[[uniform], [public]] vec2 tiling = vec2(1.0, 1.0);
[[uniform], [public]] vec2 offset = vec2(0.0, 0.0);
[[uniform], [public]] vec3 sssColor = vec3(1.0, 0.35, 0.25);
[[uniform], [public]] float sssIntensity = 0.5;
[[uniform], [public]] float detailRoughnessStrength = 0.5;
[[uniform], [public]] vec3 emissionColor = vec3(0.0, 0.0, 0.0);
[[uniform], [public]] float emissionIntensity = 1.0;

#ifndef STANDARD_SHADER_CUSTOM_FRAGMENT
vec2 fragment_uv() {
    return UV;
}

vec4 fragment_diffuse(vec2 tiledUV) {
    return texture(diffuse, tiledUV);
}

vec2 fragment_normal(vec2 uv) {
    return texture(normal, uv).rg;
}
#endif

void fragment() {
    vec2 uv = fragment_uv();
    vec2 absTiling = abs(tiling);
    vec2 tiledUV = uv * absTiling + offset;

    vec2 flipMask = step(tiling, vec2(0.0));
    tiledUV = mix(tiledUV, offset + absTiling - (uv * absTiling), flipMask);
    vec4 diffuseColor = fragment_diffuse(tiledUV) * color;

#ifdef HAS_ALPHA
    #ifdef HAS_ALPHA_MASK
        float maskAlpha = texture(alphaMask, tiledUV).r;
        diffuseColor.a *= maskAlpha;
    #endif

    if (diffuseColor.a < alphaThreshold) {
        discard;
    }
    float alpha = diffuseColor.a;
#else
    float alpha = 1.0;
#endif

    float maybe_unused_shadowIntensity = shadowIntensity;
    float maybe_unused_specular = specular;

    float roughnessValue = roughness;
    float metallicValue = metallic;
    float aoValue = 1.0;

#ifdef HAS_ORM
    // упакованная текстура glTF: r - occlusion, g - roughness, b - metallic
    vec3 orm = texture(ORM, tiledUV).rgb;
    aoValue = mix(1.0, orm.r, occlusionStrength);
    roughnessValue = roughnessValue * orm.g;
    metallicValue = metallicValue * orm.b;
#else
    #ifdef HAS_ROUGHNESS
        roughnessValue = roughnessValue * texture(roughnessMap, tiledUV).r;
    #endif
#endif

#ifdef HAS_DETAIL_WEIGHT
    float detailWeightValue = texture(detailWeight, tiledUV).r;
    // базовый roughness → более шероховатый в местах detail
    roughnessValue = mix(
        roughnessValue,
        clamp(roughnessValue + detailRoughnessStrength, 0.04, 1.0), detailWeightValue
    );
#endif

#ifdef HAS_SSS
    float maybe_unused_sssIntensity = sssIntensity * texture(sss, tiledUV).r;
    vec3 maybe_unused_sssColor = sssColor;
#else
    float maybe_unused_sssIntensity = 0.0;
    vec3 maybe_unused_sssColor = vec3(0.0);
#endif

#ifdef HAS_EMISSION
    vec3 emissionValue = texture(emission, tiledUV).rgb * emissionColor * emissionIntensity;
#else
    vec3 emissionValue = emissionColor * emissionIntensity;
#endif

#ifdef HAS_NORMAL
    //vec3 tangentNormal = normalize(texture(normal, UV).rgb * 2.0 - 1.0);

    vec2 enc = fragment_normal(tiledUV);
    vec3 tangentNormal;
    tangentNormal.xy = (enc * 2.0 - 1.0) * normalStrength;
    tangentNormal.y *= -1.0;
    float xyLen = dot(tangentNormal.xy, tangentNormal.xy);
    tangentNormal.z = sqrt(max(0.0, 1.0 - min(xyLen, 1.0)));
    tangentNormal = normalize(tangentNormal);
#else
    vec3 tangentNormal = NORMAL;
#endif

    // G-buffer, кодировка описана в Common/gbuffer.srsl
    vec3 gbufferNormalWS = NORMAL;
#ifdef HAS_NORMAL
    gbufferNormalWS = normalize(TBN * tangentNormal);
#endif
    COLOR_INDEX_1 = vec4(1.0, clamp(metallicValue, 0.0, 1.0), clamp(roughnessValue, 0.02, 1.0), alpha);
    COLOR_INDEX_2 = vec4(VERTEX, alpha);
    COLOR_INDEX_3 = vec4(gbufferNormalWS * 0.5 + 0.5, alpha);

    vec3 unused_var0 = GROUND_COLOR;
    vec3 unused_var1 = SKY_COLOR;
    vec3 unused_var2 = SUN_COLOR;
    float unused_var3 = AMBIENT_INTENSITY;
    float unused_var4 = SUN_INTENSITY;
    float unused_var5 = SHADOW_STRENGTH;
    float unused_var6 = AMBIENT_INTENSITY;

#ifdef SR_DEFINE_USE_CASCADED_SHADOW_MAP
    vec3 shadowColor = CalculateShadow(
        VERTEX,
        tangentNormal,
        diffuseColor.rgb,
        maybe_unused_specular,
        maybe_unused_shadowIntensity,
        roughnessValue, aoValue, metallicValue,
        maybe_unused_sssIntensity,
        maybe_unused_sssColor,
        emissionValue
    ).rgb;
    COLOR = vec4(shadowColor, alpha);
#else
    vec3 mappedNormal = normalize(TBN * tangentNormal);
    float light = dot(mappedNormal, DIRECTIONAL_LIGHT_DIRECTION);
    light = clamp(light, 0.0, 1.0);

    float ambient = 0.2 * aoValue;
    float direct = 0.8 * light;
    vec3 normalShade = diffuseColor.rgb * (ambient + direct) + emissionValue;

    COLOR = vec4(normalShade, alpha);
#endif

#ifdef SR_DEFINE_DEBUG_NORMALS
    COLOR = vec4(NORMAL, 1.0);
#endif
}
