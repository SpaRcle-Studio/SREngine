ShaderType Compute;

struct Voxel {
    float density; // текущая плотность
    float w0;      // вес почвы (трава)
    float w1;      // вес камня
    float w2;      // вес песка
};

[[ssbo(voxels)]] Voxel[] voxels;

[[const], [uniform]] int densityCountAxis = 0;
[[const], [uniform]] float isoLevel = 0.2;
[[const], [uniform]] ivec3 chunkCoord = ivec3(0, 0, 0);
[[const], [uniform]] float noiseScale = 0.05;
[[const], [uniform]] int seed = 42;
[[const], [uniform]] int lodScale = 1;

float fade(float t) {
    return t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
}

float grad(int hash, vec3 p) {
    int h = hash & 15;
    float u = h < 8 ? p.x : p.y;
    float v = h < 4 ? p.y : (h == 12 || h == 14 ? p.x : p.z);
    return ((h & 1) == 0 ? u : -u) + ((h & 2) == 0 ? v : -v);
}

int permute(int x) {
    return int(mod(float((x * 34 + 1) * x + seed), 289.0));
}

float perlinNoise(vec3 p) {
    ivec3 pi = ivec3(floor(p));
    vec3 pf = fract(p);

    int A = permute(pi.x) + pi.y;
    int AA = permute(A) + pi.z;
    int AB = permute(A + 1) + pi.z;
    int B = permute(pi.x + 1) + pi.y;
    int BA = permute(B) + pi.z;
    int BB = permute(B + 1) + pi.z;

    vec3 f = vec3(fade(pf.x), fade(pf.y), fade(pf.z));

    float res = mix(
        mix(
            mix(grad(permute(AA), pf),
                grad(permute(BA), pf - vec3(1.0, 0.0, 0.0)),
                f.x),
            mix(grad(permute(AB), pf - vec3(0.0, 1.0, 0.0)),
                grad(permute(BB), pf - vec3(1.0, 1.0, 0.0)),
                f.x),
            f.y),
        mix(
            mix(grad(permute(AA + 1), pf - vec3(0.0, 0.0, 1.0)),
                grad(permute(BA + 1), pf - vec3(1.0, 0.0, 1.0)),
                f.x),
            mix(grad(permute(AB + 1), pf - vec3(0.0, 1.0, 1.0)),
                grad(permute(BB + 1), pf - vec3(1.0, 1.0, 1.0)),
                f.x),
            f.y),
        f.z);

    return res * 0.5 + 0.5; // normalize to [0..1]
}

float fbm(vec3 p) {
    float v = 0.0;
    float a = 0.5;

    for (int i = 0; i < 5; i++)
    {
        v += perlinNoise(p) * a;
        p *= 2.0;
        a *= 0.5;
    }

    return v;
}

float fbm2(vec2 p) {
    return fbm(vec3(p.x, p.y, 0.0));
}

float ridged(vec3 p)
{
    float n = perlinNoise(p);
    n = 1.0 - abs(n * 2.0 - 1.0);
    return n * n;
}

/// ivec3 chunkCoord - координаты чанка в мире (могут быть отрицательными)
Voxel CalculateVoxel(float density, vec3 worldPos, vec3 noisePos) {
    Voxel voxel;
    voxel.density = density;

    float height = worldPos.y - 16.0;

    // === БИОМ ===
    float biome = fbm2(noisePos.xz * 0.02) * 0.5 + 0.5;

    // 0 → пустыня
    // 1 → нормальный/горный регион

    // === ДОП. ВАРИАЦИЯ ===
    float variation = fbm(noisePos * 0.1);

    // === ВЫСОТНЫЕ ФАКТОРЫ ===
    float sandLevel = 18.0 + biome * 10.0 + variation * 2.0;
    float rockLevel = 35.0 + variation * 5.0;

    // === ГЛУБИНА (ВАЖНО) ===
    float underground = clamp(density / 10.0, 0.0, 1.0);

    // === ВЕСА МАТЕРИАЛОВ ===
    float sand = 0.0;
    float grass = 0.0;
    float rock = 0.0;

    // --- песок ---
    sand = 1.0 - smoothstep(sandLevel - 3.0, sandLevel + 3.0, height);
    sand *= (1.0 - biome); // песок только в "пустынных" регионах

    // --- трава ---
    float grassZone = smoothstep(sandLevel - 2.0, sandLevel + 4.0, height) *
                      (1.0 - smoothstep(rockLevel - 5.0, rockLevel + 5.0, height));

    grass = grassZone * (1.0 - underground);

    // --- камень ---
    rock = underground; // под землей всегда камень

    // плюс горы
    float mountainFactor = smoothstep(30.0, 60.0, height);
    rock = max(rock, mountainFactor);

    // === НОРМАЛИЗАЦИЯ ===
    vec3 weights = vec3(grass, rock, sand);
    weights /= max(dot(weights, vec3(1.0)), 0.0001);

    /// Веса всех трёх материалов сохраняются целиком и плавно интерполируются по треугольнику,
    /// поэтому на стыке трёх материалов нет скачков
    voxel.w0 = weights.x;
    voxel.w1 = weights.y;
    voxel.w2 = weights.z;

    return voxel;
}

[[THREADS(8, 8, 8)]]
void compute() {
    ivec3 voxelPos = ivec3(GLOBAL_INVOCATION_ID.xyz);

    if (any(greaterThanEqual(voxelPos, ivec3(densityCountAxis)))) {
       return;
    }

    int index = voxelPos.x
             + voxelPos.y * densityCountAxis
             + voxelPos.z * densityCountAxis * densityCountAxis;

    // Глобальная мировая позиция. Чанк LOD покрывает lodScale чанков нулевого уровня, воксель 1 совпадает с LOD0
    vec3 world = vec3(chunkCoord * (densityCountAxis - 2) + ivec3(1) + (voxelPos - ivec3(1)) * ivec3(lodScale));
    world.y += 32.0; // смещение, чтобы не было артефактов на границах чанков

    vec3 noisePos = world * (max((noiseScale - isoLevel), 0.0) / 100.0);

    float continents = fbm(noisePos * 0.01);
    float hills = fbm(noisePos * 0.1) * 20.0;
    float mountains = ridged(noisePos * 0.05) * 60.0;

    float terrainHeight = 20.0 + hills + mountains * continents;
    float density = terrainHeight - world.y;

    voxels[index] = CalculateVoxel(density, world, noisePos);
}
