ShaderType Compute;

struct Vertex {
	vec3 position;
	vec3 normal;
};

[[ssbo(vertices)]] uint vertexCount;
[[ssbo(vertices)]] Vertex[] vertices;

[[ssbo(indices)]] uint indicesCount;
[[ssbo(indices)]] uint[] indices;

[[ssbo(densities)]] float[] densities;

#include <Samples/MarchingCubes/MarchTables.srsl>

[[const]] int densityCountAxis = 64;
[[const]] float isoLevel = 0.2;
[[const]] float voxelSize = 0.1;
[[const]] int numPointsPerAxis = 16;

float GetDensity(ivec3 pos) {
    if (pos.x < 0 || pos.x >= densityCountAxis ||
        pos.y < 0 || pos.y >= densityCountAxis ||
        pos.z < 0 || pos.z >= densityCountAxis) {
        return 0.0; // или любое другое значение по умолчанию
    }
    int sizeX = densityCountAxis;
    int sizeY = densityCountAxis;
    int index = pos.z * sizeY * sizeX + pos.y * sizeX + pos.x;
    return densities[index];
}

vec3 VertexInterp(float iso, vec3 p1, vec3 p2, float valp1, float valp2) {
    float t = (iso - valp1) / (valp2 - valp1);
    t = clamp(t, 0.0, 1.0); // на всякий случай
    return mix(p1, p2, t);
}

vec3 coordToWorld(ivec3 coord) {
    float planetSize = 1.0;
    int textureSize = 2;
	return (coord / (textureSize - 1.0) - 0.5) * planetSize;
}

int indexFromCoord(ivec3 coord) {
	/// coord = coord - int3(chunkCoord);
	return coord.z * numPointsPerAxis * numPointsPerAxis + coord.y * numPointsPerAxis + coord.x;
}

vec3 calculateNormal(ivec3 coord) {
	ivec3 offsetX = ivec3(1, 0, 0);
	ivec3 offsetY = ivec3(0, 1, 0);
	ivec3 offsetZ = ivec3(0, 0, 1);

	float dx = GetDensity(coord + offsetX) - GetDensity(coord - offsetX);
	float dy = GetDensity(coord + offsetY) - GetDensity(coord - offsetY);
	float dz = GetDensity(coord + offsetZ) - GetDensity(coord - offsetZ);

	return normalize(vec3(dx, dy, dz));
}

Vertex createVertex(ivec3 coordA, ivec3 coordB) {
    vec3 posA = coordToWorld(coordA);
    vec3 posB = coordToWorld(coordB);
    float densityA = GetDensity(coordA);
    float densityB = GetDensity(coordB);

    float t = (isoLevel - densityA) / (densityB - densityA);
    vec3 position = posA + t * (posB - posA);

    vec3 normalA = calculateNormal(coordA);
    vec3 normalB = calculateNormal(coordB);
    vec3 normal = normalize(normalA + t * (normalB - normalA));

    int indexA = indexFromCoord(coordA);
    int indexB = indexFromCoord(coordB);

    Vertex vertex;
    vertex.position = position;
    vertex.normal = normal;

    return vertex;
}

[[THREADS(8, 8, 8)]]
void compute() {
    ivec3 voxelPos = ivec3(GLOBAL_INVOCATION_ID.xyz);

    int cubeIndex = 0;
    ivec3 cornerCoords[8];

    for (int i = 0; i < 8; ++i) {
        cornerCoords[i] = voxelPos + cornerOffsets[i];
        if (GetDensity(cornerCoords[i]) < isoLevel) {
            cubeIndex |= (1 << i); // Устанавливаем бит, если плотность ниже порога
        }
    }

    //if (cubeIndex == 0 || cubeIndex == 255) {
    //    return; // Если все плотности выше или ниже порога, выходим
    //}

    int edgeCount = 0;
    int triTableValues[15];

    for (int i = 0; i < 15; i++) {
        int triTableValue = triangulation_official[cubeIndex][edgeCount];
        if (triTableValue == -1) {
            break; // Выходим, если достигли конца таблицы
        }
        triTableValues[edgeCount] = triTableValue;
        edgeCount++;
    }

    uint verticesIndex = atomicAdd(vertexCount, edgeCount);
    uint indicesIndex = atomicAdd(indicesCount, edgeCount);

    for (int edgeIndex = 0; edgeIndex < edgeCount; edgeIndex++) {
        int triTableValue = triTableValues[edgeIndex];
        vec3 edgeStart = voxelPos + edges[triTableValue][0];
        vec3 edgeEnd = voxelPos + edges[triTableValue][1];

        vec3 vertexPos = (edgeStart + edgeEnd) / 2.0;

        vertices[verticesIndex + edgeIndex].position = vertexPos;
        indices[indicesIndex + edgeIndex] = verticesIndex + edgeIndex;
    }
}
