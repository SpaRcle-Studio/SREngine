vec2 fragment_uv() {
    // uv не подходит для трипланарного текстурирования
    return vec2(0.0);
}

vec4 fragment_diffuse(vec2 tiledUV) {
    vec4 color = triplanarMaterial();
    return color;
}

vec2 fragment_normal(vec2 uv) {
    //return texture(normal, uv).rg;
    return vec2(0.5, 0.5); // плоская нормаль, т.к. нормали в трипланаре не нужны
}

#define STANDARD_SHADER_CUSTOM_FRAGMENT
#include <Engine/Shaders/standard.srsl>

VertexType TriplanarMeshVertex;