[[uniform], [public]] float textureScale = 0.5; // масштаб текстуры
[[uniform], [public]] sampler2D soilTex;
[[uniform], [public]] sampler2D stoneTex;
[[uniform], [public]] sampler2D sandTex;
[[uniform], [public]] float blendSharpness = 0.25; // ширина перехода между материалами с учётом рельефа текстур

float hash(vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

vec2 getTileOffset(vec2 pos) {
    vec2 tile = floor(pos * 0.25); // размер тайла

    float h = hash(tile);
    float angle = h * 6.2831;

    float s = sin(angle);
    float c = cos(angle);

    // небольшой сдвиг
    vec2 offset = vec2(c, s) * 4.0; // амплитуда

    return offset;
}

vec4 sampleTriplanar(sampler2D tex, vec2 uvX, vec2 uvY, vec2 uvZ, vec3 blend) {
    vec4 x = texture(tex, uvX);
    vec4 y = texture(tex, uvY);
    vec4 z = texture(tex, uvZ);
    return x * blend.x + y * blend.y + z * blend.z;
}

vec4 triplanarMaterial() {
    vec3 n = normalize(NORMAL);

    // веса для смешивания по осям
    vec3 blend = abs(n);
    blend = pow(blend, vec3(4.0));          // резкость перехода
    blend /= (blend.x + blend.y + blend.z); // нормализация

    // проекции координат считаются один раз для всех материалов
    vec2 uvX = VERTEX.zy * textureScale + getTileOffset(VERTEX.zy);
    vec2 uvY = VERTEX.xz * textureScale + getTileOffset(VERTEX.xz);
    vec2 uvZ = VERTEX.xy * textureScale + getTileOffset(VERTEX.xy);

    vec4 soil = sampleTriplanar(soilTex, uvX, uvY, uvZ, blend);
    vec4 stone = sampleTriplanar(stoneTex, uvX, uvY, uvZ, blend);
    vec4 sand = sampleTriplanar(sandTex, uvX, uvY, uvZ, blend);

    // Веса всех трёх материалов интерполируются по треугольнику (раньше id материала был flat и
    // на стыке трёх материалов менялся скачком по границе треугольника)
    vec3 weights = max(MATERIAL_WEIGHTS.xyz, vec3(0.0));
    weights /= max(weights.x + weights.y + weights.z, 0.0001);

    // Height blend: в зоне перехода материал с более "высоким" рельефом проступает раньше,
    // переход получается естественным, без мыльного полупрозрачного смешивания
    vec3 heights = vec3(
        dot(soil.rgb, vec3(0.333)),
        dot(stone.rgb, vec3(0.333)),
        dot(sand.rgb, vec3(0.333))
    );
    vec3 h = weights + heights * weights;
    float hMax = max(max(h.x, h.y), h.z) - max(blendSharpness, 0.001);
    vec3 b = max(h - vec3(hMax), vec3(0.0));
    b /= max(b.x + b.y + b.z, 0.0001);

    return soil * b.x + stone * b.y + sand * b.z;
}

vec2 fragment_uv() {
    // uv не подходит для трипланарного текстурирования
    return vec2(0.0);
}

vec4 fragment_diffuse(vec2 tiledUV) {
    vec4 color = triplanarMaterial();
    return color;
}

vec2 fragment_normal(vec2 uv) {
    //return texture(normal, uv).rg;
    return vec2(0.5, 0.5); // плоская нормаль, т.к. нормали в трипланаре не нужны
}

#define STANDARD_SHADER_CUSTOM_FRAGMENT
#include <Engine/Shaders/standard.srsl>

VertexType TriplanarMeshVertex;