ShaderType PostProcessing;

PolygonMode Point;
CullMode None;
DepthCompare LessOrEqual;
PrimitiveTopology PointList;
BlendEnabled false;
DepthWrite true;
DepthTest true;

struct NeuronRenderData {
    vec3 position;
    vec4 color;
};

[[ssbo(neurons)]] uint neuronsCount;
[[ssbo(neurons)]] NeuronRenderData[] neurons;

[[shared]] vec4 neuronColor;

void fragment() {
    COLOR = neuronColor;
}

void vertex() {
    gl_PointSize = 5.0;
    neuronColor = neurons[gl_InstanceIndex].color;
    OUT_POSITION = PROJECTION_MATRIX * VIEW_MATRIX * vec4(neurons[gl_InstanceIndex].position, 1.0);
}