ShaderType PostProcessing;

PolygonMode Fill;
CullMode Back;
DepthCompare LessOrEqual;
PrimitiveTopology TriangleList;
BlendEnabled false;
DepthWrite false;
DepthTest false;

[[public], [uniform(SHARED)]] float vignetteIntensity = 0.585;
[[public], [uniform(SHARED)]] float chromaticAberrationIntensity = 1.0;

[[uniform]] sampler2D colorMap;

[[shared]] vec2 uv;

//#ifndef SR_HDR
//    #undef SR_AUTO_EXPOSURE
//#endif

#ifdef SR_AUTO_EXPOSURE
    [[ssbo(exposure)]] float[] exposure;
#endif

#ifdef SR_SSAO
    [[uniform]] sampler2D SSAO;
#endif

#ifdef SR_VOLUMETRIC_CLOUDS
    [[uniform]] sampler2D cloudsMap;
    [[uniform]] sampler2D cloudsDepthMap;
#endif

#ifdef SR_VOLUMETRIC_FOG
    [[uniform]] sampler2D fogMap;
    [[uniform]] sampler2D fogDepthMap;
#endif

#ifdef SR_BLOOM
    [[public], [uniform(SHARED)]] float bloomIntensity = 0.6;
    [[uniform]] sampler2D bloomMap;

    // bloom в пониженном разрешении, а сэмплеры кадровых буферов NEAREST - билинейка вручную
    vec3 sampleBloom(vec2 coord) {
        vec2 size = vec2(textureSize(bloomMap, 0));
        vec2 pixel = coord * size - 0.5;
        vec2 base = floor(pixel);
        vec2 f = pixel - base;
        vec3 c00 = textureLod(bloomMap, (base + vec2(0.5, 0.5)) / size, 0.0).rgb;
        vec3 c10 = textureLod(bloomMap, (base + vec2(1.5, 0.5)) / size, 0.0).rgb;
        vec3 c01 = textureLod(bloomMap, (base + vec2(0.5, 1.5)) / size, 0.0).rgb;
        vec3 c11 = textureLod(bloomMap, (base + vec2(1.5, 1.5)) / size, 0.0).rgb;
        return mix(mix(c00, c10, f.x), mix(c01, c11, f.x), f.y);
    }
#endif

#ifdef SR_SSR
    [[public], [uniform(SHARED)]] float ssrIntensity = 1.0;
    [[uniform]] sampler2D ssrMap;
    [[uniform]] sampler2D ssrDepthMap;
    [[uniform]] sampler2D normalMap;
#endif

#if defined(SR_VOLUMETRIC_CLOUDS) || defined(SR_VOLUMETRIC_FOG) || defined(SR_SSR)
    [[uniform]] sampler2D positionMap;
    [[uniform]] sampler2D coverageMap;

    #include <Engine/Shaders/Common/gbuffer.srsl>

    // вес выборки низкого разрешения по совпадению ее дистанции с нужной поверхностью
    float lowResDepthWeight(float sampleDistance, float targetDistance) {
        bool targetSky = (targetDistance > 999999.0);
        bool sampleSky = (sampleDistance > 999999.0);
        if (targetSky || sampleSky) {
            return (targetSky == sampleSky) ? 1.0 : 0.0;
        }
        float relDiff = abs(sampleDistance - targetDistance) / max(min(sampleDistance, targetDistance), 0.5);
        return exp(-relDiff * relDiff * 200.0);
    }

    // Апсемпл буфера пониженного разрешения с учетом глубины (joint bilateral).
    // depthTex - дистанция, которую видел проход пониженного разрешения (его слой 1, см. gbufferLowResDistance).
    // targetDistance - дистанция поверхности, для которой нужен результат (1e6 - небо).
    // Быстрый путь: все 4 ближайшие выборки той же глубины (почти весь экран) - обычная билинейка.
    // Медленный путь только у силуэтов: окно 4x4, внутренние 2x2 с билинейными весами, внешнее кольцо
    // с малым весом - запас для тонких объектов. Внутри окна веса совпадают с быстрым путем, шва нет.
    vec4 sampleLowResAt(sampler2D tex, sampler2D depthTex, vec2 coord, float targetDistance) {
        vec2 lowResSize = vec2(textureSize(tex, 0));
        vec2 texel = 1.0 / lowResSize;

        vec2 pixel = coord * lowResSize - 0.5;
        vec2 base = floor(pixel);
        vec2 f = pixel - base;

        vec2 uv00 = (base + vec2(0.5, 0.5)) * texel;
        vec2 uv10 = (base + vec2(1.5, 0.5)) * texel;
        vec2 uv01 = (base + vec2(0.5, 1.5)) * texel;
        vec2 uv11 = (base + vec2(1.5, 1.5)) * texel;

        float d00 = lowResDepthWeight(textureLod(depthTex, uv00, 0.0).r, targetDistance);
        float d10 = lowResDepthWeight(textureLod(depthTex, uv10, 0.0).r, targetDistance);
        float d01 = lowResDepthWeight(textureLod(depthTex, uv01, 0.0).r, targetDistance);
        float d11 = lowResDepthWeight(textureLod(depthTex, uv11, 0.0).r, targetDistance);

        if (min(min(d00, d10), min(d01, d11)) > 0.6) {
            vec4 c00 = textureLod(tex, uv00, 0.0);
            vec4 c10 = textureLod(tex, uv10, 0.0);
            vec4 c01 = textureLod(tex, uv01, 0.0);
            vec4 c11 = textureLod(tex, uv11, 0.0);
            return mix(mix(c00, c10, f.x), mix(c01, c11, f.x), f.y);
        }

        vec2 w0 = (1.0 - f) * 0.1;
        vec2 w1 = 1.0 - f;
        vec2 w2 = f;
        vec2 w3 = f * 0.1;

        vec4 result = vec4(0.0);
        float weightSum = 0.0;
        vec4 bestSample = vec4(0.0, 0.0, 0.0, 1.0);
        float bestWeight = -1.0;

        for (int y = 0; y < 4; y++) {
            float wy = w0.y;
            if (y == 1) { wy = w1.y; }
            if (y == 2) { wy = w2.y; }
            if (y == 3) { wy = w3.y; }
            for (int x = 0; x < 4; x++) {
                float wx = w0.x;
                if (x == 1) { wx = w1.x; }
                if (x == 2) { wx = w2.x; }
                if (x == 3) { wx = w3.x; }

                vec2 sampleUV = (base + vec2(float(x) - 1.0, float(y) - 1.0) + 0.5) * texel;
                float depthWeight = lowResDepthWeight(textureLod(depthTex, sampleUV, 0.0).r, targetDistance);

                float w = wx * wy * (depthWeight + 1e-4);
                vec4 value = textureLod(tex, sampleUV, 0.0);
                result += value * w;
                weightSum += w;

                // запасной вариант для тонких объектов, у которых нет ни одной выборки своей глубины
                if (depthWeight > bestWeight) {
                    bestWeight = depthWeight;
                    bestSample = value;
                }
            }
        }

        if (bestWeight < 0.05) {
            return bestSample;
        }
        return result / max(weightSum, 1e-6);
    }

    // Апсемпл с учетом покрытия пикселя геометрией: на силуэте (MSAA, полупрозрачные объекты)
    // результат для объекта и для фона смешиваются в той же пропорции, что и цвет сцены.
    vec4 sampleLowRes(sampler2D tex, sampler2D depthTex, vec2 coord, float coverage, float surfaceDistance) {
        if (coverage <= GBUFFER_MIN_COVERAGE) {
            return sampleLowResAt(tex, depthTex, coord, 1e6);
        }
        vec4 surface = sampleLowResAt(tex, depthTex, coord, surfaceDistance);
        if (coverage >= 0.98) {
            return surface;
        }
        vec4 background = sampleLowResAt(tex, depthTex, coord, 1e6);
        return mix(background, surface, coverage);
    }
#endif

#ifdef SR_LINEARIZE_DEPTH_CASCADES
    #include <Engine/Shaders/Common/linearize-depth.srsl>
    [[uniform]] sampler2DArray shadowMap;
#endif

#define USE_COLOR_INDEX_0

float rand(vec2 co) {
    return fract(sin(dot(co.xy, vec2(12.9898, 78.233))) * 43758.5453);
}

float noiseGlitch(float x) {
    return fract(sin(x * 12.9898) * 43758.5453);
}

vec3 applyGlitch(vec3 color, vec2 originalUV) {
    vec2 glitchUV = originalUV;
    float glitchTime = TIME * 3.025;

    // горизонтальные полосы
    float lineHeight = 0.02; // высота полосы
    float yOffset = mod(originalUV.y + glitchTime * 0.5, lineHeight * 2.0);
    if (yOffset < lineHeight) {
        glitchUV.x += 0.03 * sin(50.0 * originalUV.y + glitchTime * 10.0); // смещение по X
        color = texture(colorMap, glitchUV).rgb;
    }

    // случайное смещение отдельных пикселей
    float glitchStrength = 0.05;
    if (rand(vec2(originalUV.y, glitchTime)) > 0.9) {
        glitchUV += vec2(glitchStrength * rand(originalUV.xy*10.0), 0.0);
        color = texture(colorMap, glitchUV).rgb;
    }

    // цветовые артефакты (каналы смещаются)
    vec2 rUV = originalUV + vec2(0.02 * sin(glitchTime * 5.0 + originalUV.y * 20.0),0.0);
    vec2 gUV = originalUV + vec2(-0.01 * cos(glitchTime * 3.0 + originalUV.y * 15.0),0.0);
    vec2 bUV = originalUV + vec2(0.015 * sin(glitchTime * 4.0 + originalUV.y * 25.0),0.0);
    color.r = texture(colorMap, rUV).r;
    color.g = texture(colorMap, gUV).g;
    color.b = texture(colorMap, bUV).b;
    return color;
}

#include <Engine/Shaders/Common/color-correction.inl.srsl>

void fragment() {
#ifdef SR_LINEARIZE_DEPTH_CASCADES
    if (uv.x < 0.3 && uv.y < 0.3) {
        vec2 localUV = uv / 0.3; // локальные uv миникарты [0..1]
        ivec2 quad = ivec2(localUV * 2.0); // 2x2 квадранта
        int cascadeIndex = quad.x + quad.y * 2; // 0..3
        vec2 quadUV = fract(localUV * 2.0); // uv внутри квадранта
        float depth = LinearizeDepth(texture(shadowMap, vec3(quadUV, cascadeIndex)).r, 10, 100);
        COLOR_INDEX_0 = vec4(vec3(depth), 1.0);
        return;
    }
#endif

    vec3 color;

    if (chromaticAberrationIntensity > 0.0) {
        float intensity = 0.005 * chromaticAberrationIntensity;
        vec2 dir = uv - vec2(0.5, 0.5);
        float dist = length(dir);
        color.r = texture(colorMap, uv + dir * (intensity) * dist).r;
        color.g = texture(colorMap, uv + dir * (0.0) * dist).g;
        color.b = texture(colorMap, uv + dir * (-intensity) * dist).b;
    }
    else {
        color = texture(colorMap, uv).rgb;
    }

#ifdef SR_SSAO
    float ssaoValue = texture(SSAO, uv).r;
    //color = mix(color, color * ssaoValue, 0.5);
    color *= pow(ssaoValue, 1.5);
#endif

    //color = applyGlitch(color, uv);

#if defined(SR_VOLUMETRIC_CLOUDS) || defined(SR_VOLUMETRIC_FOG) || defined(SR_SSR)
    // покрытие пикселя геометрией (MSAA и полупрозрачные объекты дают значения между 0 и 1)
    vec4 gCoverage = textureLod(coverageMap, uv, 0.0);
    vec4 gPosition = textureLod(positionMap, uv, 0.0);
    float coverage = clamp(gCoverage.r, 0.0, 1.0);
    float centerDistance = gbufferDistance(gPosition, coverage);
#endif

#ifdef SR_SSR
    // отражения до облаков и тумана - они лежат на поверхности
    if (gbufferHasGeometry(coverage)) {
        vec3 N = gbufferNormal(textureLod(normalMap, uv, 0.0), coverage);
        vec3 V = normalize(VIEW_POSITION - gbufferPosition(gPosition, coverage));
        float metallic = gbufferMetallic(gCoverage);
        float roughness = gbufferRoughness(gCoverage);

        // Френель Шлика с поправкой на шероховатость; F0 диэлектрика 0.04
        float F0 = mix(0.04, 1.0, metallic);
        float NdotV = clamp(dot(N, V), 0.0, 1.0);
        float F = F0 + (max(1.0 - roughness, F0) - F0) * pow(1.0 - NdotV, 5.0);
        // отражение принадлежит только геометрии - на силуэте ослабляется по покрытию
        F *= ssrIntensity * coverage;

        // ssr хранится premultiplied: rgb = цвет * достоверность, a = достоверность
        vec4 ssr = sampleLowResAt(ssrMap, ssrDepthMap, uv, centerDistance);
        vec3 tint = mix(vec3(1.0), color / max(max(color.r, max(color.g, color.b)), 1e-4), metallic);
        color = color * (1.0 - F * ssr.a) + ssr.rgb * tint * F;
    }
#endif

#ifdef SR_VOLUMETRIC_CLOUDS
    // облака посчитаны в пониженном разрешении: rgb - рассеянный свет, a - пропускание
    vec4 clouds = sampleLowRes(cloudsMap, cloudsDepthMap, uv, coverage, centerDistance);
    color = color * clouds.a + max(clouds.rgb, vec3(0.0));
#endif

#ifdef SR_VOLUMETRIC_FOG
    // туман ближе облаков - накладывается поверх: rgb - рассеянный свет, a - пропускание
    vec4 fog = sampleLowRes(fogMap, fogDepthMap, uv, coverage, centerDistance);
    color = color * fog.a + max(fog.rgb, vec3(0.0));
#endif

#ifdef SR_BLOOM
    color += sampleBloom(uv) * bloomIntensity;
#endif

    float r = length(uv - 0.5);

    // чем выше vignetteIntensity, тем сильнее затемнение краёв
    float vignette = smoothstep(0.5, 0.5 + (1.0 - vignetteIntensity), r);

    color *= 1.0 - vignette;

#ifdef SR_SRGB
    #ifdef SR_AUTO_EXPOSURE
        color *= exposure[0];
    #else
        color *= 0.6; /// fallback exposure if auto-exposure is disabled
    #endif

    color = ACESFilm(color);
    //color = ACES(color);
    color = pow(color, vec3(1.0 / 2.2));
#endif

    COLOR_INDEX_0 = vec4(color, texture(colorMap, uv).a);
}

void vertex() {
    uv = vec2(float((VERTEX_INDEX << 1) & 2), float(VERTEX_INDEX & 2));
    OUT_POSITION = vec4(uv * 2.0 - 1.0, 0.0, 1.0);
}