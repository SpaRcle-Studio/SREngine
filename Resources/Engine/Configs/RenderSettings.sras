sra format
use tabs: true
0-r:Root
	1-o:asset
		2-v:type
			3-s:RenderSettings
		2-o:ptr
			3-a:presets
				4-k:i
					5-o:d
						6-v:name
							7-s:Only geometry MSAA
						6-a:shaderDefines
						6-v:mainCameraRenderTechnique
							7-s:Engine/Render/Geometry.srtech
						6-v:editorCameraRenderTechnique
							7-s:Editor/Render/GeometryClearTest.srtech
				4-k:i
					5-o:d
						6-v:name
							7-s:Empty
						6-a:shaderDefines
				4-k:i
					5-o:d
						6-v:name
							7-s:Geometry + No debug
						6-a:shaderDefines
						6-v:mainCameraRenderTechnique
							7-s:Engine/Render/Geometry.srtech
						6-v:editorCameraRenderTechnique
							7-s:Editor/Render/GeometryNoDebug.srtech
				4-k:i
					5-o:d
						6-v:name
							7-s:Post process
						6-a:shaderDefines
						6-v:mainCameraRenderTechnique
							7-s:Engine/Render/PostProcess.srtech
						6-v:editorCameraRenderTechnique
							7-s:Editor/Render/PostProcess.srtech
				4-k:i
					5-o:d
						6-v:name
							7-s:Default with game color buffer
						6-a:shaderDefines
							7-k:i
								8-v:d
									9-s:SR_DEFINE_USE_CASCADED_SHADOW_MAP
						6-v:mainCameraRenderTechnique
							7-s:Engine/Render/FullRenderUnusedWithColorBuffer.srtech
						6-v:editorCameraRenderTechnique
							7-s:Editor/Render/FullRender.srtech
				4-k:i
					5-o:d
						6-v:name
							7-s:Default with game color buffer no shadows
						6-a:shaderDefines
						6-v:mainCameraRenderTechnique
							7-s:Engine/Render/FullRenderWithColorBufferNoShadows.srtech
						6-v:editorCameraRenderTechnique
							7-s:Editor/Render/FullRender.srtech
				4-k:i
					5-o:d
						6-v:name
							7-s:Cascades depth debug
						6-a:shaderDefines
							7-k:i
								8-v:d
									9-s:SR_DEFINE_USE_CASCADED_SHADOW_MAP
						6-v:mainCameraRenderTechnique
							7-s:Engine/Render/CascadedMapToScreen.srtech
						6-v:editorCameraRenderTechnique
							7-s:Editor/Render/FullRender.srtech
				4-k:i
					5-o:d
						6-v:name
							7-s:Simple
						6-a:shaderDefines
						6-v:editorCameraRenderTechnique
							7-s:Editor/Render/Simple.srtech
				4-k:i
					5-o:d
						6-v:name
							7-s:[Broken] Post process no color pick
						6-a:shaderDefines
							7-k:i
								8-v:d
									9-s:SR_DEFINE_USE_CASCADED_SHADOW_MAP
						6-v:editorCameraRenderTechnique
							7-s:Editor/Render/PostProcessNoColorPick.srtech
				4-k:i
					5-o:d
						6-v:name
							7-s:[Broken] Post process instancing
						6-a:shaderDefines
							7-k:i
								8-v:d
									9-s:SR_DEFINE_USE_CASCADED_SHADOW_MAP
						6-v:mainCameraRenderTechnique
							7-s:Engine/Render/PostProcessInstancing.srtech
						6-v:editorCameraRenderTechnique
							7-s:Engine/Render/PostProcessInstancing.srtech
				4-k:i
					5-o:d
						6-v:name
							7-s:Debug cascades map instancing
						6-a:shaderDefines
						6-v:editorCameraRenderTechnique
							7-s:Editor/Render/CascadesToScreenInstancing.srtech
				4-k:i
					5-o:d
						6-v:name
							7-s:Debug cascades map
						6-a:shaderDefines
						6-v:editorCameraRenderTechnique
							7-s:Editor/Render/CascadesToScreen.srtech
				4-k:i
					5-o:d
						6-v:name
							7-s:Geometry with color pick
						6-a:shaderDefines
						6-v:editorCameraRenderTechnique
							7-s:Editor/Render/GeometryWithColorPick.srtech
			3-o:defaultPreset
				4-v:name
					5-s:Default
				4-a:shaderDefines
				4-v:mainCameraRenderTechnique
					5-s:Engine/Render/Render.srptech
				4-v:editorCameraRenderTechnique
					5-s:Engine/Render/Render.srptech
			3-a:shadowQualityPresets
				4-k:item
					5-v:first
						6-s:Low
					5-o:second
						6-v:shadowMapResolution
							7-i:1024
						6-v:cascadesCount
							7-i:2
						6-v:frustumCount
							7-i:0
				4-k:item
					5-v:first
						6-s:Medium
					5-o:second
						6-v:shadowMapResolution
							7-i:2048
						6-v:cascadesCount
							7-i:3
						6-v:frustumCount
							7-i:1
				4-k:item
					5-v:first
						6-s:Ultra
					5-o:second
						6-v:frustumCount
							7-i:0
				4-k:item
					5-v:first
						6-s:Extreme
					5-o:second
						6-v:shadowMapResolution
							7-i:8192
						6-v:frustumCount
							7-i:0
			3-a:colorBufferQualityPresets
			3-a:SSAOQualityPresets
				4-k:item
					5-v:first
						6-s:None
					5-o:second
						6-v:preScale
							7-f:0
						6-v:sampleCount
							7-i:0
				4-k:item
					5-v:first
						6-s:Low
					5-o:second
						6-v:preScale
							7-f:0.5
						6-v:sampleCount
							7-i:32
				4-k:item
					5-v:first
						6-s:Medium
					5-o:second
						6-v:preScale
							7-f:0.7
						6-v:sampleCount
							7-i:32
				4-k:item
					5-v:first
						6-s:High
					5-o:second
			3-a:defaultPlatformGraphicsSettings
				4-k:i
					5-o:d
						6-o:platform
							7-v:has
								8-b:true
							7-v:value
								8-s:Emscripten
						6-o:graphics
							7-v:instancing
								8-b:false
							7-v:shadowsInstancing
								8-b:false
							7-v:postProcess
								8-b:false
							7-v:hdr
								8-b:false
							7-v:autoExposure
								8-b:false
							7-v:SSAO
								8-s:None
							7-v:shadowsQuality
								8-s:None
							7-v:colorBufferQuality
								8-s:None
				4-k:i
					5-o:d
