sra format
use tabs: true
0-r:Root
	1-o:asset
		2-v:type
			3-s:RenderSettings
		2-o:ptr
			3-a:presets
				4-k:i
					5-o:d
						6-v:name
							7-s:Only geometry MSAA
						6-a:shaderDefines
						6-v:mainCameraRenderTechnique
							7-s:Engine/Render/Geometry.srtech
						6-v:editorCameraRenderTechnique
							7-s:Editor/Render/GeometryClearTest.srtech
				4-k:i
					5-o:d
						6-v:name
							7-s:Empty
						6-a:shaderDefines
				4-k:i
					5-o:d
						6-v:name
							7-s:Geometry + No debug
						6-a:shaderDefines
						6-v:mainCameraRenderTechnique
							7-s:Engine/Render/Geometry.srtech
						6-v:editorCameraRenderTechnique
							7-s:Editor/Render/GeometryNoDebug.srtech
				4-k:i
					5-o:d
						6-v:name
							7-s:[Broken] Post process
						6-a:shaderDefines
							7-k:i
								8-v:d
									9-s:SR_DEFINE_USE_CASCADED_SHADOW_MAP
						6-v:mainCameraRenderTechnique
							7-s:Engine/Render/PostProcess.srtech
						6-v:editorCameraRenderTechnique
							7-s:Engine/Render/PostProcess.srtech
				4-k:i
					5-o:d
						6-v:name
							7-s:Default with game color buffer
						6-a:shaderDefines
							7-k:i
								8-v:d
									9-s:SR_DEFINE_USE_CASCADED_SHADOW_MAP
						6-v:mainCameraRenderTechnique
							7-s:Engine/Render/FullRenderUnusedWithColorBuffer.srtech
						6-v:editorCameraRenderTechnique
							7-s:Editor/Render/FullRender.srtech
				4-k:i
					5-o:d
						6-v:name
							7-s:Default with game color buffer no shadows
						6-a:shaderDefines
						6-v:mainCameraRenderTechnique
							7-s:Engine/Render/FullRenderWithColorBufferNoShadows.srtech
						6-v:editorCameraRenderTechnique
							7-s:Editor/Render/FullRender.srtech
				4-k:i
					5-o:d
						6-v:name
							7-s:Cascades depth debug
						6-a:shaderDefines
							7-k:i
								8-v:d
									9-s:SR_DEFINE_USE_CASCADED_SHADOW_MAP
						6-v:mainCameraRenderTechnique
							7-s:Engine/Render/CascadedMapToScreen.srtech
						6-v:editorCameraRenderTechnique
							7-s:Editor/Render/FullRender.srtech
				4-k:i
					5-o:d
						6-v:name
							7-s:Simple
						6-a:shaderDefines
						6-v:editorCameraRenderTechnique
							7-s:Editor/Render/Simple.srtech
				4-k:i
					5-o:d
						6-v:name
							7-s:[Broken] Post process no color pick
						6-a:shaderDefines
							7-k:i
								8-v:d
									9-s:SR_DEFINE_USE_CASCADED_SHADOW_MAP
						6-v:editorCameraRenderTechnique
							7-s:Editor/Render/PostProcessNoColorPick.srtech
				4-k:i
					5-o:d
						6-v:name
							7-s:[Broken] Post process instancing
						6-a:shaderDefines
							7-k:i
								8-v:d
									9-s:SR_DEFINE_USE_CASCADED_SHADOW_MAP
						6-v:mainCameraRenderTechnique
							7-s:Engine/Render/PostProcessInstancing.srtech
						6-v:editorCameraRenderTechnique
							7-s:Engine/Render/PostProcessInstancing.srtech
				4-k:i
					5-o:d
						6-v:name
							7-s:Debug cascades map instancing
						6-a:shaderDefines
						6-v:editorCameraRenderTechnique
							7-s:Editor/Render/CascadesToScreenInstancing.srtech
				4-k:i
					5-o:d
						6-v:name
							7-s:Debug cascades map
						6-a:shaderDefines
						6-v:editorCameraRenderTechnique
							7-s:Editor/Render/CascadesToScreen.srtech
				4-k:i
					5-o:d
						6-v:name
							7-s:Geometry with color pick
						6-a:shaderDefines
						6-v:editorCameraRenderTechnique
							7-s:Editor/Render/GeometryWithColorPick.srtech
			3-o:defaultPreset
				4-v:name
					5-s:Default
				4-a:shaderDefines
					5-k:i
						6-v:d
							7-s:SR_DEFINE_USE_CASCADED_SHADOW_MAP
				4-v:mainCameraRenderTechnique
					5-s:Engine/Render/FullRender.srtech
				4-v:editorCameraRenderTechnique
					5-s:Editor/Render/FullRender.srtech
