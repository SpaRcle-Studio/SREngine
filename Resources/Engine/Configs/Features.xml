<?xml version="1.0"?>
<Features>
    <Unused>
        <CompilePDB Value="true"/>
        <VulkanTracy Value="false"/>
        <SkyboxCPUUsage Value="false"/>
        <LoadSkybox Value="false"/>
        <MTRendering Value="false"/>
        <ChunkSystem Value="true"/>
    </Unused>
    <Common>
        <!-- Debug -->
        <ShowScriptsCodegenResult Value="false"/>
        <SegmentationHandler Value="false"/>
        <ResourceUsePointStackTraceProfiling Value="false"/>
        <VulkanValidationErrorAsAssert Value="false"/>
        <VulkanValidation Value="false"/>
        <VulkanGPUAssist Value="false"/>

        <!-- Render -->
        <HeadlessPipeline Value="false"/>
        <ColorBufferPick Value="true"/>
        <RayTracing Value="false"/>
        <Renderer Value="true"/>
        <MainWindow Value="true"/>
        <Multisampling Value="true"/>
        <FrustumCulling Value="true"/>
        <OptimizedRenderUpdate Value="true"/>
        <BorderlessWindow Value="true"/>
        <VulkanDynamicRendering Value="true"/>
        <UpdateMeshesOnDemand Value="true"/>
        <FBOForEachSwapchainImage Value="false"/>
        <MultiRenderTargets Value="false"/>
        <MultiFrameResources Value="true"/>
        <MultiFrameSSBOResources Value="true"/>
        <UseGLSLangCompiler Value="true"/>

        <!-- Editor -->
        <Gizmo Value="true"/>
        <ImGUI Value="true"/>
        <Editor Value="true"/>
        <EditorOnStartup Value="true"/>
        <EditorCamera Value="true"/>
        <EditorWidgetsDocking Value="true"/>
        <InputIgnoreNonFocusedWidgets Value="true"/>
        <UpdateNonHoveredSceneViewer Value="false"/>
        <Undocking Value="true"/>

        <!-- Core -->
        <TextureCompression Value="true"/>
        <TextureCaching Value="true"/>
        <TextureAsyncLoad Value="true"/>
        <ScriptCompilation Value="true"/>
        <AutoReloadResources Value="true"/>
        <LoadDefaultGraphicsResources Value="true"/>
        <AccumulateDt Value="true"/>
        <FastModelsLoad Value="true"/>
        <FileWatching Value="true"/>
        <RunGameModeOnStart Value="false"/>

        <!-- Physics -->
        <Physics Value="true"/>
        <PVD Value="false"/>
        <Vehicles Value="true"/>

        <!-- Variants -->
        <Variant Name="Debug">
        </Variant>

        <Variant Name="Release">
            <VulkanValidation Value="false"/>
            <VulkanGPUAssist Value="false"/>
        </Variant>

        <Variant Name="Emscripten">
            <TextureCompression Value="false"/>
            <TextureCaching Value="false"/>
            <Emscripten Value="true"/>
            <Gizmo Value="false"/>
            <ImGUI Value="false"/>
            <Editor Value="false"/>
            <EditorOnStartup Value="false"/>
            <FastModelsLoad Value="false"/>
            <ScriptCompilation Value="false"/>
            <RunGameModeOnStart Value="true"/>
        </Variant>

        <Variant Name="Android">
            <TextureCompression Value="false"/>
            <TextureCaching Value="false"/>
            <FastModelsLoad Value="false"/>
            <ScriptCompilation Value="false"/>
        </Variant>

        <Variant Name="Validation">
            <VulkanValidation Value="true"/>
            <VulkanGPUAssist Value="true"/>
        </Variant>
    </Common>
</Features>