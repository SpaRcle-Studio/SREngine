ShaderType Compute;

[[ssbo(outData)]] int[] outData;

[[THREADS(1, 1, 1)]]
void compute() {
    int i = 0;
    int acc = 0;

    while (i < 10) {
        acc += i;
        i += 1;
    }

    int j = 10;
    while (j > 0) {
        acc -= 1;
        j -= 1;
    }

    outData[0] = i;
    outData[1] = acc;
}
