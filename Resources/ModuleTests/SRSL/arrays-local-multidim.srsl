ShaderType Compute;

[[ssbo(outv)]] int[] outv;

[[THREADS(1, 1, 1)]]
void compute() {
    int[4] a = { 1, 2, 3, 4 };
    int[2][2] b = { { 10, 11 }, { 20, 21 } };
    float[2][3] c = { { 0.1, 0.2, 0.3 }, { 1.1, 1.2, 1.3 } };

    int idx = (a[0] + a[3]) - 3;
    int v0 = a[idx];
    int v1 = b[0][1] + b[1][0];
    int v2 = int(c[1][2] * 10.0);

    outv[0] = v0;
    outv[1] = v1;
    outv[2] = v2;
}
