ShaderType Compute;

[[uniform]] mat4 M;
[[ssbo(outv)]] vec4[] outv;

[[THREADS(1, 1, 1)]]
void compute() {
    vec4 v = vec4(1.0, 2.0, 3.0, 1.0);
    vec4 r = M * v;

    float m00 = M[0][0];
    float m13 = M[1][3];
    float m30 = M[3][0];

    outv[0] = r;
    outv[1] = vec4(m00, m13, m30, 1.0);
}
