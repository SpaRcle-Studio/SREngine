ShaderType Compute;

[[uniform]] vec2 resolution;
[[ssbo(outData)]] float[] outData;

[[THREADS(1, 1, 1)]]
void compute() {
    int rx = int(resolution.x);
    int ry = int(resolution.y);

    float fx = float(rx);
    float fy = float(ry);

    outData[0] = fx / max(1.0, resolution.x);
    outData[1] = fy / max(1.0, resolution.y);
    outData[2] = float(int(fx + fy));
}
