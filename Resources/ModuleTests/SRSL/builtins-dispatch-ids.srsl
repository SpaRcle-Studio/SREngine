ShaderType Compute;

[[ssbo(outv)]] uvec4[] outv;

[[THREADS(4, 2, 1)]]
void compute() {
    uvec3 gid = gl_GlobalInvocationID;
    uvec3 lid = gl_LocalInvocationID;
    uvec3 wid = gl_WorkGroupID;

    outv[0] = uvec4(gid, 1u);
    outv[1] = uvec4(lid, 1u);
    outv[2] = uvec4(wid, 1u);
    outv[3] = uvec4(gl_NumWorkGroups, 1u);
}
