ShaderType Spatial;

PolygonMode Fill;
CullMode Back;
DepthCompare LessOrEqual;
PrimitiveTopology TriangleList;
BlendEnabled false; 
DepthWrite true;
DepthTest true;

[[uniform], [public]] vec4 varVec4;
[[uniform], [public]] vec3 varVec3;
[[uniform], [public]] vec2 varVec2;
[[uniform], [public]] float varFloat;
[[uniform], [public]] int varInt;
[[uniform], [public]] bool varBool;
[[uniform], [public]] sampler2D varSampler2D;

void fragment() {
    vec4 stub = texture(varSampler2D, UV);
    stub = stub + varVec4;
    stub = stub + vec4(varVec3, 1.0);
    stub = stub + vec4(varVec2, 1.0, 1.0);
    stub = stub + vec4(varFloat);
    stub = stub + vec4(varInt);
    stub = stub + vec4(varBool);

    COLOR = vec4(UV, 1.0, 1.0) + (stub * 0.0);
}

void vertex() {
    OUT_POSITION = PROJECTION_MATRIX * VIEW_MATRIX * MODEL_MATRIX * vec4(VERTEX, 1.0);
}